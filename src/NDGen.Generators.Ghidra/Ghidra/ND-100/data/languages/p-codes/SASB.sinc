# SASB: Store the A register contents in the segment table bank (STBNK)
:SASB disp3 is op10=0x307 & disp3 & fixed3=0x1 {
    # SASB: Bank operation with B-relative addressing
    local addr:2 = B + zext(disp3);           # B-relative addressing with 3-bit displacement
    *:2 addr = A;                             # Store A register to bank
    # SASB: Segment Table Bank (STB) - privileged memory management operation
}