:STD ea_calc is op5=0x04 & ea_calc {  # Top 5 bits: 00100 = 0x04, mask 1111_1000_0000_0000
    # STD: Store double word - A to (ea), D to (ea+1) - supports all 8 addressing modes
    local ea_addr:2 = ea_calc;              # Get the calculated address
    *:2 ea_addr = A;                        # Store A to memory location
    *:2 (ea_addr + 1) = D;                  # Store D to next word (word-addressed)
}