# LACB: Load the A register from the core map-table bank (CMBNK)
:LACB disp3 is op10=0x307 & disp3 & fixed3=0x2 {
    # LACB: Bank operation with B-relative addressing
    local addr:2 = B + zext(disp3);           # B-relative addressing with 3-bit displacement
    A = *:2 addr;                             # Load into A register from bank
    # LACB: Core Map Bank (CMB) - privileged memory management operation
}