:MIN disp is op5=0x08 & disp {  # 040000 octal = 0x4000, mask 1111_1000_0000_0000 (5 bits), pattern 0x08
    local min_addr:2 = inst_start + 1 + disp;   # P-relative addressing (word-addressed)
    # MIN: Memory increment and skip next instruction if zero
    local memval:2 = *:2 min_addr;
    memval = memval + 1;
    *:2 min_addr = memval;
    # Skip next instruction if result is zero (SLEIGH limitation: cannot implement)
    # Condition: memval == 0, Target: inst_next + 2
    # This instruction should skip the next instruction when memory value becomes zero
}