:SUB disp is op5=0x19 & disp {  # Top 5 bits: 11001 = 0x19, mask 1111_1000_0000_0000
    # SUB: A = A - (memory value) - P-relative addressing only for now
    local addr:2 = inst_next + sext(disp);
    local memval:2 = *:2 addr;
    local old_a:2 = A;                       # Save original A for overflow check

    # SUB uses 2's complement: A + (~memval + 1) equivalent to C# doAdd(A, ~value, 1)
    local complement:2 = ~memval;
    local tmp:4 = zext(A) + zext(complement) + 1;  # 2's complement subtraction
    A = tmp:2;                               # Store result

    # Carry flag: Set if any bit > 15 is set in sum
    STS[6,6] = (tmp >> 16) != 0;             # Carry flag (C) - bit 6

    # Overflow logic from C# doAdd: both operands same sign, result different sign
    local bit15differs_1:2 = (old_a & 0x8000) ^ (complement & 0x8000);    # 0 if same signs
    local bit15differs_2:2 = (complement & 0x8000) ^ (A & 0x8000);        # !=0 if different signs
    local overflow:1 = (bit15differs_1 == 0) && (bit15differs_2 != 0);
    STS[5,5] = overflow;                     # Static overflow flag (O) - bit 5
    STS[4,4] = overflow;                     # Dynamic overflow flag (Q) - bit 4
}