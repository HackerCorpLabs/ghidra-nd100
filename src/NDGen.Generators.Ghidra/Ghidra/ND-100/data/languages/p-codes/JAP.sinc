:JAP disp is op8=0xB0 & disp {  # 0130000 octal = 0xB000, mask 1111_1111_0000_0000 (8 bits), pattern 0xB0
    # FIXED IMPLEMENTATION: Use same pattern as working JMP instruction
    local addr:2 = inst_start + 1 + disp;  # Calculate PC-relative target (same as JMP)
    if ((A & 0x8000) == 0) goto [addr];  # Jump if A positive (sign bit clear)
}