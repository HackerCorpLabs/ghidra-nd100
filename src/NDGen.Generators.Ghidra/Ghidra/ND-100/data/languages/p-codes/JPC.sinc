# 5. Address calculation:
#    - Target = (PC - 1) + displacement  # PC already incremented before call
#    - Range: -128 to +127 words (signed 8-bit displacement)
#
# 6. Jump conditions:
#    - JUMP: X[15] == 0 after increment (X positive or zero)
#    - NO JUMP: X[15] == 1 after increment (X negative)
#
# Count-and-jump instruction for loop control and array indexing.
# Critical for implementing FOR loops and counted operations.
#
:JPC disp is op8=0xB4 & disp {  # 0132000 octal = 0xB400, mask 1111_1111_0000_0000 (8 bits), pattern 0xB4
    # FIXED IMPLEMENTATION: Use same pattern as working JMP instruction
    X = X + 1;  # ALWAYS increment X first
    local addr:2 = inst_start + 1 + disp;  # Calculate PC-relative target (same as JMP)
    if ((X & 0x8000) == 0) goto [addr];  # Jump if X positive after increment
}
