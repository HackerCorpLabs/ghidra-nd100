# LXCB: Load the X register from the core table bank (CMBNK)
:LXCB disp3 is op10=0x307 & disp3 & fixed3=0x5 {
    # LXCB: Bank operation with B-relative addressing
    local addr:2 = B + zext(disp3);           # B-relative addressing with 3-bit displacement
    X = *:2 addr;                             # Load into X register from bank
    # LXCB: Core Map Bank (CMB) - privileged memory management operation
}