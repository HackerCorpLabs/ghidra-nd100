# RDCR: Register decrement (compound mnemonic for RADD CM1)
# 13-bit mask instruction, last 3 bits specify destination register
:RDCR reg3 is op13=0x1C90 & reg3 {
    # RDCR: Register decrement - compound mnemonic for "RADD CM1"
    # This decrements the specified register by 1
    # Register destination specified in bits 2-0
    local old_val:2 = 0;
    local new_val:4 = 0;
    local overflow:1 = 0;

    # TODO: Need proper register decoding based on reg3 value
    # For now, just decrement A register as example
    old_val = A;
    new_val = zext(A) + 0xFFFF;                  # Add -1 (0xFFFF in 16-bit 2's complement)
    A = new_val:2;

    # Set flags like RADD instruction
    STS[6,6] = (new_val >> 16) != 0;             # Carry flag (C) - bit 6
    overflow = (old_val == 0x8000) && (A == 0x7FFF); # Overflow from min negative to positive
    STS[5,5] = overflow;                         # Static overflow flag (O) - bit 5
    STS[4,4] = overflow;                         # Dynamic overflow flag (Q) - bit 4
}