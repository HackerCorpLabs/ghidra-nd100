# LASB: Load the A register with contents of segment-table bank (STBNK)
:LASB disp3 is op10=0x307 & disp3 & fixed3=0x0 {
    # LASB: Bank operation with B-relative addressing
    local addr:2 = B + zext(disp3);           # B-relative addressing with 3-bit displacement
    A = *:2 addr;                             # Load into A register from bank
    # LASB: Segment Table Bank (STB) - privileged memory management operation
}