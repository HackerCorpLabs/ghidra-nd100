:ADD disp is op5=0x0C & disp {  # 060000 octal = 0x6000, 5-bit mask
    local addr:2 = inst_start + 2 + disp;   # P-relative addressing
    local memval:2 = *:2 addr;               # Load memory value
    local tmp:4 = zext(A) + zext(memval);    # 32-bit add
    A = tmp:2;                               # Store result
    STS[6,6] = (tmp >> 16) != 0;             # Carry flag (C) - bit 6
    STS[5,5] = scarry(A, memval);            # Static overflow flag (O) - bit 5
    STS[4,4] = scarry(A, memval);            # Dynamic overflow flag (Q) - bit 4
}


