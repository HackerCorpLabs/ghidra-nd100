# ND-100 SLEIGH Specification
# Generated by NDGen from YAML definitions

define endian=big;
define alignment=2;

# Define RAM as word-addressed (wordsize=2 for 16-bit words)
define space ram type=ram_space size=2 wordsize=2 default;
define space register type=register_space size=2;
define space io_space type=ram_space size=2;

# ND-100 CPU Registers from YAML specifications (code order: STS=0, D=1, P=2, B=3, L=4, A=5, T=6, X=7)
define register offset=0x0000 size=2 [STS D P B L A T X];

# Additional ND-100 system registers and flags referenced in processor spec
define register offset=0x0010 size=1 [
    C Q O Z K TG M PTM PIL PVL IONI PONI SEXI N100
    PANS PANC LMP OPR ALD PID PIE PK IID IIE IIC
    PGS PGC PEA PES CSR LCIL UCIL CCL CILP ECCR CS EA STATE
];

define token instr (16)
    op5 = (11,15)     # 5-bit opcode field for instructions with 5-bit mask
    op8 = (8,15)      # 8-bit opcode field for instructions with 8-bit mask
    op9 = (7,15)      # 9-bit opcode field for bit operations
    op10 = (6,15)     # 10-bit opcode field for extended operations
    op12 = (4,15)     # 12-bit opcode field for register operations
    op13 = (3,15)     # 13-bit opcode field for complex operations
    op16 = (0,15)     # 16-bit opcode field for instructions with 16-bit mask (no operands)

    # Addressing mode fields (bits 10-8) - CRITICAL for memory reference instructions
    mode = (8,10)     # 3-bit addressing mode field
    X_bit = (10,10)   # X flag (bit 10) - indexed addressing when 1
    I_bit = (9,9)     # I flag (bit 9) - indirect addressing when 1
    B_bit = (8,8)     # B flag (bit 8) - B-relative when 1, P-relative when 0

    disp = (0,7)      # 8-bit displacement field (signed)
    disp3 = (3,5)     # 3-bit displacement field for 10-bit mask instructions
    fixed3 = (0,2)    # 3-bit fixed field for 10-bit mask instructions (bits 2-0)
    reg3 = (0,2)      # 3-bit register field for EXR instruction
    reg4 = (0,3)      # 4-bit register field
    level6 = (0,5)    # 6-bit level code field for IDENT instruction (bits 5-0)
    bit4 = (3,6)      # 4-bit bit number field

    # Fields for non-contiguous mask instructions
    shift7 = (0,6)    # 7-bit shift count/mode for SHA/SHD/SHT/SAD
    skp_cond = (8,10)  # 3-bit condition code for SKP instruction (bits 10-8)
    skp_fixed = (6,7)  # 2-bit fixed field for SKP (bits 7-6, must be 00)
    skp_sr = (3,5)     # 3-bit source register for SKP
    skp_dr = (0,2)     # 3-bit destination register for SKP
    rop_src = (3,5)    # 3-bit source register field for register operations
    rop_dst = (0,2)    # 3-bit destination register field for register operations
;

# ND100 PC-relative jump instructions use direct disp pattern like JMP
# Each jump instruction calculates target address in its semantic action
# Pattern: local target:2 = inst_start + 2 + sext(disp); if (condition) goto [target];

@include "nd100_registers.sinc"
@include "nd100_memory.sinc"
@include "nd100.sinc"

