:IOX disp is op5=0x1D & disp {  # 0164000 octal = 0xE800, 5-bit mask
    local device_addr:2 = disp;              # Device register address
    local is_output:2 = device_addr & 1;     # Bit 0 determines direction (2-byte for size matching)
    if (is_output == 0) goto <input>;
    *[io_space]:2 device_addr = A;           # Output A to device
    goto <done>;
<input>
    A = *[io_space]:2 device_addr;           # Input from device to A
<done>
}


