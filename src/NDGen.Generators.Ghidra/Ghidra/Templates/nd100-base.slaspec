# ND-100 SLEIGH Specification
# Generated by NDGen from YAML definitions

define endian=big;
define alignment=2;

# Define RAM as word-addressed (wordsize=2 for 16-bit words)
define space ram type=ram_space size=2 wordsize=2 default;
define space register type=register_space size=2;
define space io_space type=ram_space size=2 wordsize=2;

# ND-100 CPU Registers from YAML specifications (code order: STS=0, D=1, P=2, B=3, L=4, A=5, T=6, X=7)
define register offset=0x0000 size=2 [STS D P B L A T X];

# Additional ND-100 system registers and flags referenced in processor spec
define register offset=0x0010 size=1 [
    C Q O Z K TG M PTM PIL PVL IONI PONI SEXI N100
    PANS PANC LMP OPR ALD PID PIE PK IID IIE IIC
    PGS PGC PEA PES CSR LCIL UCIL CCL CILP ECCR CS EA STATE
];

define token instr (16)
    op5 = (11,15)     # 5-bit opcode field for instructions with 5-bit mask
    op8 = (8,15)      # 8-bit opcode field for instructions with 8-bit mask
    op9 = (7,15)      # 9-bit opcode field for bit operations
    op10 = (6,15)     # 10-bit opcode field for extended operations
    op12 = (4,15)     # 12-bit opcode field for register operations
    op13 = (3,15)     # 13-bit opcode field for complex operations
    op16 = (0,15)     # 16-bit opcode field for instructions with 16-bit mask (no operands)

    # Addressing mode fields (bits 10-8) - CRITICAL for memory reference instructions
    mode = (8,10)     # 3-bit addressing mode field
    X_bit = (10,10)   # X flag (bit 10) - indexed addressing when 1
    I_bit = (9,9)     # I flag (bit 9) - indirect addressing when 1
    B_bit = (8,8)     # B flag (bit 8) - B-relative when 1, P-relative when 0

    disp = (0,7) signed  # 8-bit signed displacement field
    imm8 = (0,7)         # 8-bit unsigned immediate (MON monitor codes)
    io_addr = (0,10)     # 11-bit I/O address for IOX/IOT (bits 10-0, full device address)
    io_dir = (0,0)       # I/O direction bit (bit 0): 0=input, 1=output
    disp3 = (3,5)     # 3-bit displacement field for 10-bit mask instructions
    fixed3 = (0,2)    # 3-bit fixed field for 10-bit mask instructions (bits 2-0)
    reg3 = (0,2)      # 3-bit register field for EXR instruction
    reg4 = (0,3)      # 4-bit register field
    level6 = (0,5)    # 6-bit level code field for IDENT instruction (bits 5-0)
    bit4 = (3,6)      # 4-bit bit number field

    # Fields for non-contiguous mask instructions
    shift7 = (0,6)    # 7-bit shift count/mode for SHA/SHD/SHT/SAD (kept for semantics)
    shift_reg = (7,8)  # 2-bit register selector for shift instructions (bits 8-7)
    shift_type = (9,10) # 2-bit shift type: 00=Arithmetic, 01=ROT, 10=ZIN, 11=LIN
    shift_dir = (5,5)   # Bit 5: 0=left(SHL), 1=right(SHR)
    shift_cnt5 = (0,4)  # 5-bit shift count (bits 4-0, for left shift)
    shift_cnt6 = (0,5)  # 6-bit field for right shift (two's complement negate)
    skp_cond = (8,10)  # 3-bit condition code for SKP instruction (bits 10-8)
    skp_fixed = (6,7)  # 2-bit fixed field for SKP (bits 7-6, must be 00)
    skp_sr = (3,5)     # 3-bit source register for SKP
    skp_dr = (0,2)     # 3-bit destination register for SKP
    rop_src = (3,5)    # 3-bit source register field for register operations
    rop_dst = (0,2)    # 3-bit destination register field for register operations

    # Display-only fields (same bits as semantic fields, for attach names)
    rop_src_d = (3,5)  # Display name for source register
    rop_dst_d = (0,2)  # Display name for destination register
    reg3_d = (0,2)     # Display name for dest-only register (RCLR, RDCR, RINC)
    skp_sr_d = (3,5)   # Display name for SKP source
    skp_dr_d = (0,2)   # Display name for SKP destination

    # TRA/TRR register selector fields (same bits as reg4, different names)
    tra_reg = (0,3)    # 4-bit register selector for TRA (read internal register)
    trr_reg = (0,3)    # 4-bit register selector for TRR (write internal register)

    # RADD family modifier fields
    rop_cld = (6,6)    # CLD modifier bit (clear destination before add)
    rop_cm1 = (7,7)    # CM1 modifier bit (complement source)
    rop_ad = (8,9)     # AD1/ADC selector: 00=none, 01=AD1(+1), 10=ADC(+carry)
;

# ENTR inline parameter token (demand word follows instruction)
define token entr_param (16)
    entr_demand = (0,15)    # Stack demand value (word count)
;

# Display names: source registers use S prefix, destination use D prefix (ND-100 convention)
attach names rop_src_d [ "0" "SD" "SP" "SB" "SL" "SA" "ST" "SX" ];
attach names rop_dst_d [ "0" "DD" "DP" "DB" "DL" "DA" "DT" "DX" ];
attach names reg3_d [ "0" "DD" "DP" "DB" "DL" "DA" "DT" "DX" ];
attach names skp_sr_d [ "0" "SD" "SP" "SB" "SL" "SA" "ST" "SX" ];
attach names skp_dr_d [ "0" "DD" "DP" "DB" "DL" "DA" "DT" "DX" ];

# SKP condition code mnemonics (ND-100 Reference Manual)
attach names skp_cond [ "EQL" "GEQ" "GRE" "MGRE" "UEQ" "LSS" "LST" "MLST" ];

# TRA internal register selector mnemonics (read direction)
attach names tra_reg [ "PANS" "STS" "OPR" "PSR" "PVL" "IIC" "PID" "PIE" "CSR" "ACTL" "ALD" "PES" "PGC" "PEA" "_" "CS" ];

# TRR internal register selector mnemonics (write direction)
attach names trr_reg [ "PANC" "STS" "LMP" "PCR" "_" "IIE" "PID" "PIE" "CCL" "LCIL" "UCIL" "CILP" "_" "ECCR" "_" "CS" ];

# ND-100 register encoding: 0=STS, 1=D, 2=P, 3=B, 4=L, 5=A, 6=T, 7=X
# Semantic bindings for P-code register access
attach variables [ rop_dst rop_src reg3 skp_dr skp_sr ] [ STS D P B L A T X ];

# Memory reference instructions use the 'addr' sub-table for addressing modes (bits 10-8)
# Conditional jumps use 'rel_target' sub-table for resolved P-relative addresses
# Both sub-tables are defined in nd100_memory.sinc

# Volatile I/O access pcodeops (required by pspec <volatile> element)
define pcodeop read_volatile;       # Volatile read from I/O space
define pcodeop write_volatile;      # Volatile write to I/O space

# Custom P-code operations for instructions that cannot be fully modeled in SLEIGH
define pcodeop nd100_fadd;          # Floating point add (48-bit ND format)
define pcodeop nd100_fsub;          # Floating point subtract
define pcodeop nd100_fmul;          # Floating point multiply
define pcodeop nd100_fdiv;          # Floating point divide
define pcodeop nd100_normalize;     # NLZ: Integer to float conversion
define pcodeop nd100_denormalize;   # DNZ: Float to integer conversion
define pcodeop nd100_bcd_add;       # ADDD: BCD addition
define pcodeop nd100_bcd_sub;       # SUBD: BCD subtraction
define pcodeop nd100_bcd_cmp;       # COMD: BCD comparison
define pcodeop nd100_bcd_pack;      # PACK: ASCII to BCD
define pcodeop nd100_bcd_unpack;    # UPACK: BCD to ASCII
define pcodeop nd100_bcd_shift;     # SHDE: Decimal shift
define pcodeop nd100_movb;          # MOVB/MOVBF: Byte field move
define pcodeop nd100_bfill;         # BFILL: Byte field fill
define pcodeop nd100_exam;          # EXAM: Read physical memory
define pcodeop nd100_depo;          # DEPO: Write physical memory
define pcodeop nd100_tset;          # TSET/TSETP: Test and set
define pcodeop nd100_ident;         # IDENT: Interrupt device ID
define pcodeop nd100_exr;           # EXR: Execute register as instruction
define pcodeop nd100_tra;           # TRA: Transfer system register to A (fallback)
define pcodeop nd100_trr;           # TRR: Transfer A to system register (fallback)

# Per-register pcodeops for TRA (read) — readable decompiler output
define pcodeop read_PANS;           # Panel status
define pcodeop read_STS;            # Status register
define pcodeop read_OPR;            # Operator panel switches
define pcodeop read_PSR;            # Paging status register
define pcodeop read_PVL;            # Previous level code
define pcodeop read_IIC;            # Internal interrupt code
define pcodeop read_PID;            # Priority interrupt detect
define pcodeop read_PIE;            # Priority interrupt enable
define pcodeop read_CSR;            # Cache status register
define pcodeop read_ACTL;           # Active level register
define pcodeop read_ALD;            # Automatic load descriptor
define pcodeop read_PES;            # Parity error status
define pcodeop read_PGC;            # Paging control register
define pcodeop read_PEA;            # Parity error address
define pcodeop read_CS;             # Control store

# Per-register pcodeops for TRR (write) — readable decompiler output
define pcodeop write_PANC;          # Panel control
define pcodeop write_STS;           # Status register
define pcodeop write_LMP;           # Panel display buffer
define pcodeop write_PCR;           # Paging control register
define pcodeop write_IIE;           # Internal interrupt enable
define pcodeop write_PID;           # Priority interrupt detect
define pcodeop write_PIE;           # Priority interrupt enable
define pcodeop write_CCL;           # Cache clear
define pcodeop write_LCIL;          # Lower cache inhibit limit
define pcodeop write_UCIL;          # Upper cache inhibit limit
define pcodeop write_CILP;          # Cache inhibit page
define pcodeop write_ECCR;          # Error correction control
define pcodeop write_CS;            # Control store
define pcodeop nd100_irr;           # IRR: Interrupt register read
define pcodeop nd100_irw;           # IRW: Interrupt register write
define pcodeop nd100_lrb;           # LRB: Load register bank
define pcodeop nd100_srb;           # SRB: Store register bank
define pcodeop nd100_mon;           # MON: Monitor call (OS trap)
define pcodeop nd100_wait;          # WAIT: Wait for condition
define pcodeop nd100_opcom;         # OPCOM: Operator console halt
define pcodeop nd100_page_op;       # Page table operations (SETPT, CLEPT, etc.)
define pcodeop nd100_movew;         # MOVEW: Word block move
define pcodeop nd100_rdus;          # RDUS/RDUSP: Read uncached
define pcodeop nd100_lbit;          # LBIT/LBITP: Load bit from memory
define pcodeop nd100_sbit;          # SBIT/SBITP: Store bit to memory
define pcodeop nd100_lbyt;          # LBYT/LBYTP: Load/store byte
define pcodeop nd100_sbyt;          # SBYT/SBYTP: Store byte
define pcodeop nd100_init;          # INIT: Stack initialization
define pcodeop nd100_lwcs;          # LWCS: Load writable control store
define pcodeop nd100_rglob;         # RGLOB: Read global pointers
define pcodeop nd100_wglob;         # WGLOB: Write global pointers
define pcodeop nd100_geco;          # GECO: Customer-specific
define pcodeop nd100_mcl;           # MCL: Master clear
define pcodeop nd100_mst;           # MST: Master status
define pcodeop nd100_versn;         # VERSN: Version info
define pcodeop nd100_ioxt;          # IOXT: I/O execute with T register address


# Skip target sub-table: resolves inst_start + 2 at disassembly time
# Used by skip instructions (BSKP, SKP, MIN) to avoid goto [local_var]
# which causes decompiler errors. The sub-table exports a resolved address.
skip_next: "*"^reloc  is epsilon [ reloc = inst_start + 2; ] { export *:2 reloc; }

# ENTR skip target: resolves inst_start + 3 for normal return (skips demand + error_ret)
entr_norm: "*"^reloc  is epsilon [ reloc = inst_start + 3; ] { export *:2 reloc; }
# ENTR error target: resolves inst_start + 2 for error return (skips demand only)
entr_err: "*"^reloc  is epsilon [ reloc = inst_start + 2; ] { export *:2 reloc; }

@include "nd100_registers.sinc"
@include "nd100_memory.sinc"
@include "nd100_shift.sinc"
@include "nd100.sinc"

# PLACEHOLDER_INSTRUCTIONS - Will be replaced with generated instructions