    # SHA: Shift A register — 4 types: Arithmetic/ROT/ZIN/LIN
    # C source: ShiftReg(gA, operand)
    # shift_operand encodes: bits 8-7=type, bit 5=dir, bits 4-0=count
    local stype:2 = (shift_operand >> 7) & 3;
    local sdir:2 = (shift_operand >> 5) & 1;
    local cnt:2 = shift_operand & 0x1F;

    if (sdir != 0) goto <right>;
    # --- Left shift ---
    if (stype == 1) goto <rot_left>;
    # Arith/ZIN/LIN left all fill with 0
    A = A << cnt;
    goto <done>;
<rot_left>
    local lcnt:2 = cnt & 0xF;
    A = (A << lcnt) | (A >> (16 - lcnt));
    goto <done>;

<right>
    # --- Right shift ---
    local rcount:2 = 32 - cnt;
    if (stype == 1) goto <rot_right>;
    if (stype == 2) goto <zin_right>;
    # Arithmetic right (type 0) and LIN right (type 3, approx — M flag not modeled)
    A = A s>> rcount;
    goto <done>;
<rot_right>
    local rcnt:2 = rcount & 0xF;
    A = (A >> rcnt) | (A << (16 - rcnt));
    goto <done>;
<zin_right>
    A = A >> rcount;                      # ZIN right = logical shift (zero fill)
<done>
