    # 140702 octal = 0xC1C2, 10-bit mask
    # LACB: Bank operation with B-relative addressing
    local ea:2 = B + disp3;              # B-relative addressing with 3-bit displacement
    A = *:2 ea;                               # Load into A register from bank
    # LACB: Bank type determined by instruction - Core Map Bank (CMB) or Segment Table Bank (STB)