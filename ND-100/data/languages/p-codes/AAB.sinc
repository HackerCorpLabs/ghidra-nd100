    # 172000 octal = 0xF400, 8-bit mask
    # AAB: B = B + disp, flags C/O/Q
    local old_b:2 = B;
    local imm:2 = disp;
    local tmp:4 = zext(old_b) + zext(imm);
    B = tmp:2;
    STS[6,6] = (tmp >> 16) != 0;                # C = carry out
    STS[5,5] = scarry(old_b, imm);              # O = signed overflow (dynamic)
    STS[4,4] = STS[4,4] | STS[5,5];            # Q = sticky overflow
