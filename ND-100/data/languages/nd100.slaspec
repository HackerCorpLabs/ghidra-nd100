# ND-100 SLEIGH Specification
# Generated by NDGen from YAML definitions

define endian=big;
define alignment=2;

# Define RAM as word-addressed (wordsize=2 for 16-bit words)
define space ram type=ram_space size=2 wordsize=2 default;
define space register type=register_space size=2;
define space io_space type=ram_space size=2 wordsize=2;

# ND-100 CPU Registers from YAML specifications (code order: STS=0, D=1, P=2, B=3, L=4, A=5, T=6, X=7)
define register offset=0x0000 size=2 [STS D P B L A T X];

# Additional ND-100 system registers and flags referenced in processor spec
define register offset=0x0010 size=1 [
    C Q O Z K TG M PTM PIL PVL IONI PONI SEXI N100
    PANS PANC LMP OPR ALD PID PIE PK IID IIE IIC
    PGS PGC PEA PES CSR LCIL UCIL CCL CILP ECCR CS EA STATE
];

define token instr (16)
    op5 = (11,15)     # 5-bit opcode field for instructions with 5-bit mask
    op8 = (8,15)      # 8-bit opcode field for instructions with 8-bit mask
    op9 = (7,15)      # 9-bit opcode field for bit operations
    op10 = (6,15)     # 10-bit opcode field for extended operations
    op12 = (4,15)     # 12-bit opcode field for register operations
    op13 = (3,15)     # 13-bit opcode field for complex operations
    op16 = (0,15)     # 16-bit opcode field for instructions with 16-bit mask (no operands)

    # Addressing mode fields (bits 10-8) - CRITICAL for memory reference instructions
    mode = (8,10)     # 3-bit addressing mode field
    X_bit = (10,10)   # X flag (bit 10) - indexed addressing when 1
    I_bit = (9,9)     # I flag (bit 9) - indirect addressing when 1
    B_bit = (8,8)     # B flag (bit 8) - B-relative when 1, P-relative when 0

    disp = (0,7) signed  # 8-bit signed displacement field
    imm8 = (0,7)         # 8-bit unsigned immediate (MON monitor codes)
    io_addr = (0,10)     # 11-bit I/O address for IOX/IOT (bits 10-0, full device address)
    io_dir = (0,0)       # I/O direction bit (bit 0): 0=input, 1=output
    disp3 = (3,5)     # 3-bit displacement field for 10-bit mask instructions
    fixed3 = (0,2)    # 3-bit fixed field for 10-bit mask instructions (bits 2-0)
    reg3 = (0,2)      # 3-bit register field for EXR instruction
    reg4 = (0,3)      # 4-bit register field
    level6 = (0,5)    # 6-bit level code field for IDENT instruction (bits 5-0)
    bit4 = (3,6)      # 4-bit bit number field

    # Fields for non-contiguous mask instructions
    shift7 = (0,6)    # 7-bit shift count/mode for SHA/SHD/SHT/SAD (kept for semantics)
    shift_reg = (7,8)  # 2-bit register selector for shift instructions (bits 8-7)
    shift_type = (9,10) # 2-bit shift type: 00=Arithmetic, 01=ROT, 10=ZIN, 11=LIN
    shift_dir = (5,5)   # Bit 5: 0=left(SHL), 1=right(SHR)
    shift_cnt5 = (0,4)  # 5-bit shift count (bits 4-0, for left shift)
    shift_cnt6 = (0,5)  # 6-bit field for right shift (two's complement negate)
    skp_cond = (8,10)  # 3-bit condition code for SKP instruction (bits 10-8)
    skp_fixed = (6,7)  # 2-bit fixed field for SKP (bits 7-6, must be 00)
    skp_sr = (3,5)     # 3-bit source register for SKP
    skp_dr = (0,2)     # 3-bit destination register for SKP
    rop_src = (3,5)    # 3-bit source register field for register operations
    rop_dst = (0,2)    # 3-bit destination register field for register operations

    # Display-only fields (same bits as semantic fields, for attach names)
    rop_src_d = (3,5)  # Display name for source register
    rop_dst_d = (0,2)  # Display name for destination register
    reg3_d = (0,2)     # Display name for dest-only register (RCLR, RDCR, RINC)
    skp_sr_d = (3,5)   # Display name for SKP source
    skp_dr_d = (0,2)   # Display name for SKP destination

    # TRA/TRR register selector fields (same bits as reg4, different names)
    tra_reg = (0,3)    # 4-bit register selector for TRA (read internal register)
    trr_reg = (0,3)    # 4-bit register selector for TRR (write internal register)

    # RADD family modifier fields
    rop_cld = (6,6)    # CLD modifier bit (clear destination before add)
    rop_cm1 = (7,7)    # CM1 modifier bit (complement source)
    rop_ad = (8,9)     # AD1/ADC selector: 00=none, 01=AD1(+1), 10=ADC(+carry)
;

# ENTR inline parameter token (demand word follows instruction)
define token entr_param (16)
    entr_demand = (0,15)    # Stack demand value (word count)
;

# Display names: source registers use S prefix, destination use D prefix (ND-100 convention)
attach names rop_src_d [ "0" "SD" "SP" "SB" "SL" "SA" "ST" "SX" ];
attach names rop_dst_d [ "0" "DD" "DP" "DB" "DL" "DA" "DT" "DX" ];
attach names reg3_d [ "0" "DD" "DP" "DB" "DL" "DA" "DT" "DX" ];
attach names skp_sr_d [ "0" "SD" "SP" "SB" "SL" "SA" "ST" "SX" ];
attach names skp_dr_d [ "0" "DD" "DP" "DB" "DL" "DA" "DT" "DX" ];

# SKP condition code mnemonics (ND-100 Reference Manual)
attach names skp_cond [ "EQL" "GEQ" "GRE" "MGRE" "UEQ" "LSS" "LST" "MLST" ];

# TRA internal register selector mnemonics (read direction)
attach names tra_reg [ "PANS" "STS" "OPR" "PSR" "PVL" "IIC" "PID" "PIE" "CSR" "ACTL" "ALD" "PES" "PGC" "PEA" "_" "CS" ];

# TRR internal register selector mnemonics (write direction)
attach names trr_reg [ "PANC" "STS" "LMP" "PCR" "_" "IIE" "PID" "PIE" "CCL" "LCIL" "UCIL" "CILP" "_" "ECCR" "_" "CS" ];

# ND-100 register encoding: 0=STS, 1=D, 2=P, 3=B, 4=L, 5=A, 6=T, 7=X
# Semantic bindings for P-code register access
attach variables [ rop_dst rop_src reg3 skp_dr skp_sr ] [ STS D P B L A T X ];

# Memory reference instructions use the 'addr' sub-table for addressing modes (bits 10-8)
# Conditional jumps use 'rel_target' sub-table for resolved P-relative addresses
# Both sub-tables are defined in nd100_memory.sinc

# Volatile I/O access pcodeops (required by pspec <volatile> element)
define pcodeop read_volatile;       # Volatile read from I/O space
define pcodeop write_volatile;      # Volatile write to I/O space

# Custom P-code operations for instructions that cannot be fully modeled in SLEIGH
define pcodeop nd100_fadd;          # Floating point add (48-bit ND format)
define pcodeop nd100_fsub;          # Floating point subtract
define pcodeop nd100_fmul;          # Floating point multiply
define pcodeop nd100_fdiv;          # Floating point divide
define pcodeop nd100_normalize;     # NLZ: Integer to float conversion
define pcodeop nd100_denormalize;   # DNZ: Float to integer conversion
define pcodeop nd100_bcd_add;       # ADDD: BCD addition
define pcodeop nd100_bcd_sub;       # SUBD: BCD subtraction
define pcodeop nd100_bcd_cmp;       # COMD: BCD comparison
define pcodeop nd100_bcd_pack;      # PACK: ASCII to BCD
define pcodeop nd100_bcd_unpack;    # UPACK: BCD to ASCII
define pcodeop nd100_bcd_shift;     # SHDE: Decimal shift
define pcodeop nd100_movb;          # MOVB/MOVBF: Byte field move
define pcodeop nd100_bfill;         # BFILL: Byte field fill
define pcodeop nd100_exam;          # EXAM: Read physical memory
define pcodeop nd100_depo;          # DEPO: Write physical memory
define pcodeop nd100_tset;          # TSET/TSETP: Test and set
define pcodeop nd100_ident;         # IDENT: Interrupt device ID
define pcodeop nd100_exr;           # EXR: Execute register as instruction
define pcodeop nd100_tra;           # TRA: Transfer system register to A (fallback)
define pcodeop nd100_trr;           # TRR: Transfer A to system register (fallback)

# Per-register pcodeops for TRA (read) — readable decompiler output
define pcodeop read_PANS;           # Panel status
define pcodeop read_STS;            # Status register
define pcodeop read_OPR;            # Operator panel switches
define pcodeop read_PSR;            # Paging status register
define pcodeop read_PVL;            # Previous level code
define pcodeop read_IIC;            # Internal interrupt code
define pcodeop read_PID;            # Priority interrupt detect
define pcodeop read_PIE;            # Priority interrupt enable
define pcodeop read_CSR;            # Cache status register
define pcodeop read_ACTL;           # Active level register
define pcodeop read_ALD;            # Automatic load descriptor
define pcodeop read_PES;            # Parity error status
define pcodeop read_PGC;            # Paging control register
define pcodeop read_PEA;            # Parity error address
define pcodeop read_CS;             # Control store

# Per-register pcodeops for TRR (write) — readable decompiler output
define pcodeop write_PANC;          # Panel control
define pcodeop write_STS;           # Status register
define pcodeop write_LMP;           # Panel display buffer
define pcodeop write_PCR;           # Paging control register
define pcodeop write_IIE;           # Internal interrupt enable
define pcodeop write_PID;           # Priority interrupt detect
define pcodeop write_PIE;           # Priority interrupt enable
define pcodeop write_CCL;           # Cache clear
define pcodeop write_LCIL;          # Lower cache inhibit limit
define pcodeop write_UCIL;          # Upper cache inhibit limit
define pcodeop write_CILP;          # Cache inhibit page
define pcodeop write_ECCR;          # Error correction control
define pcodeop write_CS;            # Control store
define pcodeop nd100_irr;           # IRR: Interrupt register read
define pcodeop nd100_irw;           # IRW: Interrupt register write
define pcodeop nd100_lrb;           # LRB: Load register bank
define pcodeop nd100_srb;           # SRB: Store register bank
define pcodeop nd100_mon;           # MON: Monitor call (OS trap)
define pcodeop nd100_wait;          # WAIT: Wait for condition
define pcodeop nd100_opcom;         # OPCOM: Operator console halt
define pcodeop nd100_page_op;       # Page table operations (SETPT, CLEPT, etc.)
define pcodeop nd100_movew;         # MOVEW: Word block move
define pcodeop nd100_rdus;          # RDUS/RDUSP: Read uncached
define pcodeop nd100_lbit;          # LBIT/LBITP: Load bit from memory
define pcodeop nd100_sbit;          # SBIT/SBITP: Store bit to memory
define pcodeop nd100_lbyt;          # LBYT/LBYTP: Load/store byte
define pcodeop nd100_sbyt;          # SBYT/SBYTP: Store byte
define pcodeop nd100_init;          # INIT: Stack initialization
define pcodeop nd100_lwcs;          # LWCS: Load writable control store
define pcodeop nd100_rglob;         # RGLOB: Read global pointers
define pcodeop nd100_wglob;         # WGLOB: Write global pointers
define pcodeop nd100_geco;          # GECO: Customer-specific
define pcodeop nd100_mcl;           # MCL: Master clear
define pcodeop nd100_mst;           # MST: Master status
define pcodeop nd100_versn;         # VERSN: Version info
define pcodeop nd100_ioxt;          # IOXT: I/O execute with T register address


# Skip target sub-table: resolves inst_start + 2 at disassembly time
# Used by skip instructions (BSKP, SKP, MIN) to avoid goto [local_var]
# which causes decompiler errors. The sub-table exports a resolved address.
skip_next: "*"^reloc  is epsilon [ reloc = inst_start + 2; ] { export *:2 reloc; }

# ENTR skip target: resolves inst_start + 3 for normal return (skips demand + error_ret)
entr_norm: "*"^reloc  is epsilon [ reloc = inst_start + 3; ] { export *:2 reloc; }
# ENTR error target: resolves inst_start + 2 for error return (skips demand only)
entr_err: "*"^reloc  is epsilon [ reloc = inst_start + 2; ] { export *:2 reloc; }

@include "nd100_registers.sinc"
@include "nd100_memory.sinc"
@include "nd100_shift.sinc"
@include "nd100.sinc"

# ND-100 Instructions Generated from YAML Definitions

:AAA disp is op8=0xF5 & disp {  # 172400 octal = 0xF500, 8-bit mask
    # 172400 octal = 0xF500, 8-bit mask
    # AAA: A = A + disp, flags C/O/Q
    local old_a:2 = A;
    local imm:2 = disp;
    local tmp:4 = zext(old_a) + zext(imm);
    A = tmp:2;
    STS[6,6] = (tmp >> 16) != 0;                # C = carry out
    STS[5,5] = scarry(old_a, imm);              # O = signed overflow (dynamic)
    STS[4,4] = STS[4,4] | STS[5,5];            # Q = sticky overflow
}


:AAB disp is op8=0xF4 & disp {  # 172000 octal = 0xF400, 8-bit mask
    # 172000 octal = 0xF400, 8-bit mask
    # AAB: B = B + disp, flags C/O/Q
    local old_b:2 = B;
    local imm:2 = disp;
    local tmp:4 = zext(old_b) + zext(imm);
    B = tmp:2;
    STS[6,6] = (tmp >> 16) != 0;                # C = carry out
    STS[5,5] = scarry(old_b, imm);              # O = signed overflow (dynamic)
    STS[4,4] = STS[4,4] | STS[5,5];            # Q = sticky overflow
}


:AAT disp is op8=0xF6 & disp {  # 173000 octal = 0xF600, 8-bit mask
    # 173000 octal = 0xF600, 8-bit mask
    # AAT: T = T + disp, flags C/O/Q
    local old_t:2 = T;
    local imm:2 = disp;
    local tmp:4 = zext(old_t) + zext(imm);
    T = tmp:2;
    STS[6,6] = (tmp >> 16) != 0;                # C = carry out
    STS[5,5] = scarry(old_t, imm);              # O = signed overflow (dynamic)
    STS[4,4] = STS[4,4] | STS[5,5];            # Q = sticky overflow
}


:AAX disp is op8=0xF7 & disp {  # 173400 octal = 0xF700, 8-bit mask
    # 173400 octal = 0xF700, 8-bit mask
    # AAX: X = X + disp, flags C/O/Q
    local old_x:2 = X;
    local imm:2 = disp;
    local tmp:4 = zext(old_x) + zext(imm);
    X = tmp:2;
    STS[6,6] = (tmp >> 16) != 0;                # C = carry out
    STS[5,5] = scarry(old_x, imm);              # O = signed overflow (dynamic)
    STS[4,4] = STS[4,4] | STS[5,5];            # Q = sticky overflow
}


:ADD addr is op5=0x0C & addr {  # 060000 octal = 0x6000, 5-bit mask (addr)
    # ADD: A = A + mem[EA]
    # Ref: Instructions.cs — flags computed from original A value, not result
    local memval:2 = addr;                    # Load memory value via addr sub-table
    local old_a:2 = A;                        # Save original A for flag computation
    local tmp:4 = zext(old_a) + zext(memval); # 32-bit add
    A = tmp:2;                                # Store result
    STS[6,6] = (tmp >> 16) != 0;              # Carry flag (C) - bit 6
    STS[5,5] = scarry(old_a, memval);         # Static overflow flag (O) - bit 5
    STS[4,4] = STS[4,4] | scarry(old_a, memval); # Dynamic overflow flag (Q) - bit 4
}


:ADDD is op16=0xC050 {  # 0140120 octal = 0xC050, 16-bit mask
    # ADDD: BCD addition — uses A+D (operand 1 descriptor), X+T (operand 2 descriptor)
    # Skips next instruction on success
    nd100_bcd_add(A, D, T, X);
}


:AND addr is op5=0x0E & addr {  # 070000 octal = 0x7000, 5-bit mask (addr)
    # 070000 octal = 0x7000, 5-bit mask (addr)
    local memval:2 = addr;                    # Load memory value via addr sub-table
    A = A & memval;                          # Bitwise AND with memory value
}


:BANC bit4 reg3_d is op9=0x1FC & bit4 & reg3 & reg3_d {  # 177000 octal = 0xFE00, 9-bit mask
    # 177000 octal = 0xFE00, 9-bit mask
    local mask:2 = 1 << bit4;                   # Create bit mask
    STS[2,2] = ((reg3 & mask) == 0) & STS[2,2]; # AND complement of bit with K
}


:BAND bit4 reg3_d is op9=0x1FD & bit4 & reg3 & reg3_d {  # 177200 octal = 0xFE80, 9-bit mask
    # 177200 octal = 0xFE80, 9-bit mask
    local mask:2 = 1 << bit4;                   # Create bit mask
    STS[2,2] = ((reg3 & mask) != 0) & STS[2,2]; # AND bit with K
}


:BFILL is op16=0xC058 {  # 0140130 octal = 0xC058, 16-bit mask
    # BFILL: Byte fill — fill field with byte from A, descriptor in T
    nd100_bfill(A, T, X);
}


:BLDA bit4 reg3_d is op9=0x1FB & bit4 & reg3 & reg3_d {  # 176600 octal = 0xFD80, 9-bit mask
    # 176600 octal = 0xFD80, 9-bit mask
    local mask:2 = 1 << bit4;                   # Create bit mask
    STS[2,2] = (reg3 & mask) != 0;              # Load bit value to K
}


:BLDC bit4 reg3_d is op9=0x1FA & bit4 & reg3 & reg3_d {  # 176400 octal = 0xFD00, 9-bit mask
    # 176400 octal = 0xFD00, 9-bit mask
    local mask:2 = 1 << bit4;                   # Create bit mask
    STS[2,2] = (reg3 & mask) == 0;              # Load complement of bit to K
}


:BORA bit4 reg3_d is op9=0x1FF & bit4 & reg3 & reg3_d {  # 177600 octal = 0xFF80, 9-bit mask
    # 177600 octal = 0xFF80, 9-bit mask
    local mask:2 = 1 << bit4;                   # Create bit mask
    STS[2,2] = ((reg3 & mask) != 0) | STS[2,2]; # OR bit with K
}


:BORC bit4 reg3_d is op9=0x1FE & bit4 & reg3 & reg3_d {  # 177400 octal = 0xFF00, 9-bit mask
    # 177400 octal = 0xFF00, 9-bit mask
    local mask:2 = 1 << bit4;                   # Create bit mask
    STS[2,2] = ((reg3 & mask) == 0) | STS[2,2]; # OR complement of bit with K
}


# BSET: Bit Set — 4 condition variants
# Encoding: bits 15-11=BOP, bits 10-7=sub-instr, bits 6-3=bn, bits 2-0=dr
# K = carry flag = STS bit 6

# BSET ZRO: clear bit (bit <- 0)
:BSET "ZRO "^bit4^" "^reg3_d is op9=0x1F0 & bit4 & reg3 & reg3_d {
    local mask:2 = 1 << bit4;
    reg3 = reg3 & ~mask;
}

# BSET ONE: set bit (bit <- 1)
:BSET "ONE "^bit4^" "^reg3_d is op9=0x1F1 & bit4 & reg3 & reg3_d {
    local mask:2 = 1 << bit4;
    reg3 = reg3 | mask;
}

# BSET BCM: complement bit (bit <- ~bit)
:BSET "BCM "^bit4^" "^reg3_d is op9=0x1F2 & bit4 & reg3 & reg3_d {
    local mask:2 = 1 << bit4;
    reg3 = reg3 ^ mask;
}

# BSET BAC: set bit to carry (bit <- K)
:BSET "BAC "^bit4^" "^reg3_d is op9=0x1F3 & bit4 & reg3 & reg3_d {
    local mask:2 = 1 << bit4;
    if (STS[6,1] != 0) goto <setbit>;
    reg3 = reg3 & ~mask;
    goto <done>;
<setbit>
    reg3 = reg3 | mask;
<done>
}


# BSKP: Bit Skip — 4 condition variants
# Encoding: bits 15-11=BOP, bits 10-7=sub-instr, bits 6-3=bn, bits 2-0=dr
# K = carry flag = STS bit 6

# BSKP ZRO: skip if bit = 0
:BSKP "ZRO "^bit4^" "^reg3_d^" "^skip_next is op9=0x1F4 & bit4 & reg3 & reg3_d & skip_next {
    local mask:2 = 1 << bit4;
    if ((reg3 & mask) != 0) goto <no_skip>;
    goto skip_next;
<no_skip>
}

# BSKP ONE: skip if bit = 1
:BSKP "ONE "^bit4^" "^reg3_d^" "^skip_next is op9=0x1F5 & bit4 & reg3 & reg3_d & skip_next {
    local mask:2 = 1 << bit4;
    if ((reg3 & mask) == 0) goto <no_skip>;
    goto skip_next;
<no_skip>
}

# BSKP BCM: skip if bit != K (bit complement match)
:BSKP "BCM "^bit4^" "^reg3_d^" "^skip_next is op9=0x1F6 & bit4 & reg3 & reg3_d & skip_next {
    local mask:2 = 1 << bit4;
    local bitval:1 = ((reg3 & mask) != 0);
    local carry:1 = STS[6,1];
    if (bitval == carry) goto <no_skip>;
    goto skip_next;
<no_skip>
}

# BSKP BAC: skip if bit == K (bit and carry)
:BSKP "BAC "^bit4^" "^reg3_d^" "^skip_next is op9=0x1F7 & bit4 & reg3 & reg3_d & skip_next {
    local mask:2 = 1 << bit4;
    local bitval:1 = ((reg3 & mask) != 0);
    local carry:1 = STS[6,1];
    if (bitval != carry) goto <no_skip>;
    goto skip_next;
<no_skip>
}


:BSTA bit4 reg3_d is op9=0x1F9 & bit4 & reg3 & reg3_d {  # 176200 octal = 0xFC80, 9-bit mask
    # 176200 octal = 0xFC80, 9-bit mask
    # BSTA: Store K to bit, then clear K
    # C source: setbit(dr, bn, K); setbit(STS, K, 0)
    local mask:2 = 1 << bit4;                   # Create bit mask
    if (STS[2,2] != 0) goto <setbit>;
    reg3 = reg3 & ~mask;                        # Clear bit (carry=0)
    goto <done>;
<setbit>
    reg3 = reg3 | mask;                         # Set bit (carry=1)
<done>
    STS[2,2] = 0;                               # Clear K after store
}


:BSTC bit4 reg3_d is op9=0x1F8 & bit4 & reg3 & reg3_d {  # 176000 octal = 0xFC00, 9-bit mask
    # 176000 octal = 0xFC00, 9-bit mask
    # BSTC: Store complement of K to bit, then set K to 1
    # C source: setbit(dr, bn, K^1); setbit(STS, K, 1)
    local mask:2 = 1 << bit4;                   # Create bit mask
    if (STS[2,2] == 0) goto <setbit>;
    reg3 = reg3 & ~mask;                        # Clear bit (carry=1, complement=0)
    goto <done>;
<setbit>
    reg3 = reg3 | mask;                         # Set bit (carry=0, complement=1)
<done>
    STS[2,2] = 1;                               # Set K to 1 after store
}


:CHREENTPAGES is op16=0xC0C3 {  # 140303 octal = 0xC0C3, 16-bit mask
    # CHREENTPAGES: Change reentrant pages in page tables — privileged
    nd100_page_op(A, D, T, X);
}


:CLEPT is op16=0xC0C1 {  # 140301 octal = 0xC0C1, 16-bit mask
    # CLEPT: Clear page tables — privileged
    # Uses A, B, T, X (B holds page table address)
    nd100_page_op(A, B, T, X);
}


:CLEPU is op16=0xC0C4 {  # 140304 octal = 0xC0C4, 16-bit mask
    # CLEPU: Clear page tables and collect PGU information — privileged
    # Uses A, B, L, T, X (L holds PGU map bank pointer)
    nd100_page_op(A, B, L, T, X);
}


:CLNREENT is op16=0xC0C2 {  # 140302 octal = 0xC0C2, 16-bit mask
    # CLNREENT: Clear non-reentrant pages — privileged
    nd100_page_op(A, D, T, X);
}


:CLPT is op16=0xC145 {  # 140505 octal = 0xC145, 16-bit mask
    # CLPT: Clear segment from page tables — privileged (ND-110/CX)
    nd100_page_op(A, D, T, X);
}


:CNREK is op16=0xC144 {  # 140504 octal = 0xC144, 16-bit mask
    # CNREK: Clear non-reentrant pages (SINTRAN K only) — privileged
    nd100_page_op(A, D, T, X);
}


:COMD is op16=0xC052 {  # 0140122 octal = 0xC052, 16-bit mask
    # COMD: BCD comparison — uses A+D (operand 1), X+T (operand 2)
    # Result in A: 1 if op1>op2, -1 if op1<op2, 0 if equal; skips on success
    A = nd100_bcd_cmp(A, D, T, X);
}


:COPY rop_src_d rop_dst_d is op8=0xCC & rop_cld=1 & rop_src_d & rop_dst_d & rop_src & rop_dst {  # 0146100 octal = 0xCC40, 8-bit alias mask
    # 0146100 octal = 0xCC40, 8-bit alias mask
    rop_dst = rop_src;                            # Copy source to destination
    STS[6,6] = 0;                                # C = 0 (no carry)
    STS[5,5] = 0;                                # O = 0 (no overflow)
}


:DEPO is op16=0xD10F {  # 150417 octal = 0xD10F, 16-bit mask
    # DEPO: Deposit to physical memory — write T to address A+D
    nd100_depo(A, D, T);
}


:DNZ disp is op8=0xD4 & disp {  # 152000 octal = 0xD400, 8-bit mask
    # DNZ: Denormalize — convert floating point T:A:D to integer in A
    # Ref: Instructions.FloatingPointConversion.cs:202
    # NOT "decrement D and jump" — that was completely wrong
    local scale:2 = disp;                     # Scaling factor (sign-extended by assignment)
    A = nd100_denormalize(T, A, D, scale);    # Convert float T:A:D to integer in A
    T = 0;                                    # T cleared after denormalize
    D = 0;                                    # D cleared after denormalize
}


:ELEAV is op16=0xC05F {  # 0140137 octal = 0xC05F, 16-bit mask
    # ELEAV: Error leave stack — decrement LINK, store A as ERRCODE, then LEAVE
    # C source: ndfunc_eleav() — LINK--, ERRCODE=A, PC=[B-128], B=[B-127]
    local link_addr:2 = B - 128;
    local prevb_addr:2 = B - 127;
    local errcode_addr:2 = B - 123;
    # Decrement LINK (return goes to error address instead of normal)
    local link:2 = *:2 link_addr;
    link = link - 1;
    *:2 link_addr = link;
    # Store error code
    *:2 errcode_addr = A;
    # LEAVE: restore frame and return
    B = *:2 prevb_addr;
    return [link];
}


:ENPT is op16=0xC146 {  # 140506 octal = 0xC146, 16-bit mask
    # ENPT: Enter segment in page tables — privileged
    nd100_page_op(A, D, T, X);
}


# ENTR: Enter stack frame — full constructor (reads inline demand word)
# C source: ndfunc_entr() in cpu_instr.c
# Encoding: 0140135₈ = 0xC05D, 16-bit mask
# Format: ENTR <demand_value> <error_ret> <normal_ret>
# The demand word follows the instruction in the code stream.
# On success: jump to inst_start+3 (skipping demand + error_ret words)
# On overflow: jump to inst_start+2 (error return)

:ENTR entr_demand, entr_err, entr_norm is op16=0xC05D ; entr_demand ; entr_err ; entr_norm {
    local demand:2 = entr_demand;
    local smax:2 = *:2 (B - 125);
    # Check stack overflow: B + demand - 122 > SMAX
    if ((B + demand - 122) > smax) goto entr_err;
    local stp:2 = *:2 (B - 126);
    local oldB:2 = B;
    B = stp + 128;
    # Save frame: LINK = L+1, PREVB = oldB, SMAX, STP
    local link_addr:2 = B - 128;
    *:2 link_addr = L + 1;
    local prevb_addr:2 = B - 127;
    *:2 prevb_addr = oldB;
    local smax_addr:2 = B - 125;
    *:2 smax_addr = smax;
    local stp_addr:2 = B - 126;
    *:2 stp_addr = B + demand - 122;
    goto entr_norm;
}


:EXAM is op16=0xD10E {  # 150416 octal = 0xD10E, 16-bit mask
    # EXAM: Examine physical memory — read from address A+D into T
    T = nd100_exam(A, D);
}


:EXIT is op16=0xCC62 {  # 0146142 octal = 0xCC62, 16-bit mask
    # EXIT: Return from subroutine (COPY SL DP = L -> P)
    # Ref: DisAssembler.cs:263 — just transfers L to P register
    return [L];                               # Return to address in L register
}


:EXR rop_src_d is op10=0x306 & rop_src_d & rop_dst_d & rop_src & rop_dst {  # 0140600 octal = 0xC180, 10-bit mask
    # EXR: Execute instruction from register — interprets register contents as instruction
    nd100_exr(rop_src);
}


:FAD ea_addr is op5=0x10 & ea_addr {  # 0100000 octal = 0x8000, 5-bit mask (ea_addr)
    # FAD: Floating point add — T:A:D += mem[EA]:mem[EA+1]:mem[EA+2]
    # C source: reads 3 words from EA, calls NDFloat_Add, modifies T/A/D
    # Called as void: pcodeop modifies T, A, D implicitly (multi-register output)
    local ea:2 = ea_addr;
    local w1:2 = *:2 ea;
    local ea1:2 = ea + 1;
    local w2:2 = *:2 ea1;
    local ea2:2 = ea + 2;
    local w3:2 = *:2 ea2;
    nd100_fadd(T, A, D, w1, w2, w3);
}


:FDV ea_addr is op5=0x13 & ea_addr {  # 114000 octal = 0x9800, 5-bit mask (ea_addr)
    # FDV: Floating point divide — T:A:D /= mem[EA]:mem[EA+1]:mem[EA+2]
    # C source: reads 3 words from EA, calls NDFloat_Div, modifies T/A/D
    local ea:2 = ea_addr;
    local w1:2 = *:2 ea;
    local ea1:2 = ea + 1;
    local w2:2 = *:2 ea1;
    local ea2:2 = ea + 2;
    local w3:2 = *:2 ea2;
    nd100_fdiv(T, A, D, w1, w2, w3);
}


:FMU ea_addr is op5=0x12 & ea_addr {  # 110000 octal = 0x9000, 5-bit mask (ea_addr)
    # FMU: Floating point multiply — T:A:D *= mem[EA]:mem[EA+1]:mem[EA+2]
    # C source: reads 3 words from EA, calls NDFloat_Mul, modifies T/A/D
    local ea:2 = ea_addr;
    local w1:2 = *:2 ea;
    local ea1:2 = ea + 1;
    local w2:2 = *:2 ea1;
    local ea2:2 = ea + 2;
    local w3:2 = *:2 ea2;
    nd100_fmul(T, A, D, w1, w2, w3);
}


:FSB ea_addr is op5=0x11 & ea_addr {  # 104000 octal = 0x8800, 5-bit mask (ea_addr)
    # FSB: Floating point subtract — T:A:D -= mem[EA]:mem[EA+1]:mem[EA+2]
    # C source: reads 3 words from EA, calls NDFloat_Sub, modifies T/A/D
    local ea:2 = ea_addr;
    local w1:2 = *:2 ea;
    local ea1:2 = ea + 1;
    local w2:2 = *:2 ea1;
    local ea2:2 = ea + 2;
    local w3:2 = *:2 ea2;
    nd100_fsub(T, A, D, w1, w2, w3);
}


:GECO is op16=0xC5C0 {  # 0142700 octal = 0xC5C0, 16-bit mask
    # GECO: Customer-specific instruction (ND-100/CE and later)
    nd100_geco(A, B, D, X);
}


# IDENT: Identify interrupt device — query device ID at priority level
# C source: level = operand & 0x3F; gA = ident(level)
# Full constructor to use level6 field (bits 5-0) instead of rop_src/rop_dst
:IDENT level6 is op10=0x31E & level6 {
    local level:1 = level6;
    A = nd100_ident(level);
}


:INIT is op16=0xC05C {  # 0140134 octal = 0xC05C, 16-bit mask
    # INIT: Initialize stack (CE/CX option)
    nd100_init(B, L, A, T, X);
}


:INSPL is op16=0xC142 {  # 140502 octal = 0xC142, 16-bit mask
    # INSPL: Insert page in page list — privileged
    nd100_page_op(A, D, T, X);
}


:IOF is op16=0xD101 {  # 150401 octal = 0xD101, 16-bit mask
    # IOF: Disable interrupt system
    IONI = 0;
}


:ION is op16=0xD102 {  # 150402 octal = 0xD102, 16-bit mask
    # ION: Enable interrupt system
    IONI = 1;
}


:IOT io_ref is op5=0x1C & io_dir & io_ref {  # 160000  octal = 0xE000, 5-bit mask (I/O)
    # 160000  octal = 0xE000, 5-bit mask (I/O)
    # io_ref sub-table exports *[io_space]:2 io_addr (value at io_space address)
    # Direction determined by bit 0: even=input, odd=output
    local dir:2 = io_dir;
    if (dir != 0) goto <output>;
    A = io_ref;
    goto <done>;
<output>
    io_ref = A;
<done>
}


:IOX io_ref is op5=0x1D & io_dir & io_ref {  # 0164000 octal = 0xE800, 5-bit mask (I/O)
    # 0164000 octal = 0xE800, 5-bit mask (I/O)
    # io_ref sub-table exports *[io_space]:2 io_addr (value at io_space address)
    # Direction determined by bit 0: even=input, odd=output
    # Using io_ref for both read and write — Ghidra creates io_space reference
    local dir:2 = io_dir;
    if (dir != 0) goto <output>;
    A = io_ref;
    goto <done>;
<output>
    io_ref = A;
<done>
}


:IOXT is op16=0xD10D {  # 150415 octal = 0xD10D, 16-bit mask
    # IOXT: I/O execute with address from T register
    # Reads: T (device address), A (data out); Writes: A (data in)
    A = nd100_ioxt(T, A);
}


:IRR bit4 reg3_d is op9=0x1AF & bit4 & reg3 & reg3_d {  # 153600 octal = 0xD780, 9-bit mask
    # IRR: Inter-level register read — read register from another level into A
    local level:1 = bit4;
    A = nd100_irr(level, reg3);
}


:IRW bit4 reg3_d is op9=0x1AE & bit4 & reg3 & reg3_d {  # 153400 octal = 0xD700, 9-bit mask
    # IRW: Inter-level register write — write A to register at another level
    local level:1 = bit4;
    nd100_irw(level, reg3, A);
}


:JAF rel_target is op8=0xB3 & rel_target {  # 0131400 octal = 0xB300, 8-bit mask (jump)
    # JAF: Jump if A Filled (A != 0)
    # Ref: Instructions.SequencingInstructions.cs:118 — CJP(regs.currentRegisters.A != 0)
    # No flags affected
    if (A == 0) goto <no_jump>;               # Skip if A is zero (empty)
    goto rel_target;                          # Jump if A filled (non-zero)
<no_jump>
}


:JAN rel_target is op8=0xB1 & rel_target {  # 0130400 octal = 0xB100, 8-bit mask (jump)
    # 0130400 octal = 0xB100, 8-bit mask (jump)
    if (A s>= 0) goto <no_jump>;              # Skip if A not negative
    goto rel_target;
<no_jump>
}


:JAP rel_target is op8=0xB0 & rel_target {  # 0130000 octal = 0xB000, 8-bit mask (jump)
    # 0130000 octal = 0xB000, 8-bit mask (jump)
    if (A s< 0) goto <no_jump>;               # Skip if A negative (jump when A >= 0)
    goto rel_target;
<no_jump>
}


:JAZ rel_target is op8=0xB2 & rel_target {  # 0131000 octal = 0xB200, 8-bit mask (jump)
    # JAZ: Jump if A is Zero
    # Ref: Instructions.SequencingInstructions.cs:114 — STS.C = (A == 0); CJP(A == 0)
    STS[6,6] = (A == 0);                     # Set carry flag to (A == 0)
    if (A != 0) goto <no_jump>;               # Skip if A not zero
    goto rel_target;
<no_jump>
}


# JMP: Jump — 8 addressing mode constructors
# Mode 0 (P-relative) uses jmp_addr sub-table for Ghidra arrows
# All other modes use goto [ea] for computed/indirect targets

# Mode 0: P-relative (uses jmp_addr sub-table for disassembly-resolved arrows)
:JMP jmp_addr is op5=0x15 & X_bit=0 & I_bit=0 & B_bit=0 & jmp_addr {
    goto jmp_addr;
}

# Mode 1: B-relative
:JMP disp^",B" is op5=0x15 & X_bit=0 & I_bit=0 & B_bit=1 & disp {
    local ea:2 = B + disp;
    goto [ea];
}

# Mode 2: Indirect P-relative
:JMP "I *"^reloc is op5=0x15 & X_bit=0 & I_bit=1 & B_bit=0 & disp [ reloc = inst_start + disp; ] {
    local ptr:2 = reloc;
    local ea:2 = *:2 ptr;
    goto [ea];
}

# Mode 3: Indirect B-relative
:JMP "I "^disp^",B" is op5=0x15 & X_bit=0 & I_bit=1 & B_bit=1 & disp {
    local ptr:2 = B + disp;
    local ea:2 = *:2 ptr;
    goto [ea];
}

# Mode 4: X-indexed
:JMP disp^",X" is op5=0x15 & X_bit=1 & I_bit=0 & B_bit=0 & disp {
    local ea:2 = X + disp;
    goto [ea];
}

# Mode 5: B+X-indexed
:JMP disp^",B,X" is op5=0x15 & X_bit=1 & I_bit=0 & B_bit=1 & disp {
    local ea:2 = B + X + disp;
    goto [ea];
}

# Mode 6: Indirect P-relative + X-indexed
:JMP ",X I *"^reloc is op5=0x15 & X_bit=1 & I_bit=1 & B_bit=0 & disp [ reloc = inst_start + disp; ] {
    local ptr:2 = reloc;
    local ea:2 = *:2 ptr;
    local target:2 = ea + X;
    goto [target];
}

# Mode 7: Indirect B-relative + X-indexed
:JMP ",X I "^disp^",B" is op5=0x15 & X_bit=1 & I_bit=1 & B_bit=1 & disp {
    local ptr:2 = B + disp;
    local ea:2 = *:2 ptr;
    local target:2 = ea + X;
    goto [target];
}


:JNC rel_target is op8=0xB5 & rel_target {  # 0132400 octal = 0xB500, 8-bit mask (jump)
    # JNC: Increment X, jump if X negative (bit 15 set)
    # Ref: Instructions.SequencingInstructions.cs:178-183 — X++; CJP(X bit 15 != 0)
    X = X + 1;                                # Increment X first
    if (X s>= 0) goto <no_jump>;              # Skip if X positive/zero
    goto rel_target;                          # Jump if X negative
<no_jump>
}


:JPC rel_target is op8=0xB4 & rel_target {  # 0132000 octal = 0xB400, 8-bit mask (jump)
    # JPC: Increment X, jump if X positive or zero (bit 15 clear)
    # Ref: Instructions.SequencingInstructions.cs:163-168 — X++; CJP(X bit 15 == 0)
    X = X + 1;                                # Increment X first
    if (X s< 0) goto <no_jump>;               # Skip if X negative (bit 15 set)
    goto rel_target;                          # Jump if X positive/zero
<no_jump>
}


# JPL: Jump and Link — 8 addressing mode constructors
# Saves return address (inst_start + 1) in L register, then calls target
# Mode 0 (P-relative) uses jmp_addr sub-table for Ghidra arrows
# All other modes use call [ea] for computed/indirect targets

# Mode 0: P-relative (uses jmp_addr sub-table for disassembly-resolved arrows)
:JPL jmp_addr is op5=0x17 & X_bit=0 & I_bit=0 & B_bit=0 & jmp_addr {
    L = inst_start + 1;
    call jmp_addr;
}

# Mode 1: B-relative
:JPL disp^",B" is op5=0x17 & X_bit=0 & I_bit=0 & B_bit=1 & disp {
    L = inst_start + 1;
    local ea:2 = B + disp;
    call [ea];
}

# Mode 2: Indirect P-relative
:JPL "I *"^reloc is op5=0x17 & X_bit=0 & I_bit=1 & B_bit=0 & disp [ reloc = inst_start + disp; ] {
    L = inst_start + 1;
    local ptr:2 = reloc;
    local ea:2 = *:2 ptr;
    call [ea];
}

# Mode 3: Indirect B-relative
:JPL "I "^disp^",B" is op5=0x17 & X_bit=0 & I_bit=1 & B_bit=1 & disp {
    L = inst_start + 1;
    local ptr:2 = B + disp;
    local ea:2 = *:2 ptr;
    call [ea];
}

# Mode 4: X-indexed
:JPL disp^",X" is op5=0x17 & X_bit=1 & I_bit=0 & B_bit=0 & disp {
    L = inst_start + 1;
    local ea:2 = X + disp;
    call [ea];
}

# Mode 5: B+X-indexed
:JPL disp^",B,X" is op5=0x17 & X_bit=1 & I_bit=0 & B_bit=1 & disp {
    L = inst_start + 1;
    local ea:2 = B + X + disp;
    call [ea];
}

# Mode 6: Indirect P-relative + X-indexed
:JPL ",X I *"^reloc is op5=0x17 & X_bit=1 & I_bit=1 & B_bit=0 & disp [ reloc = inst_start + disp; ] {
    L = inst_start + 1;
    local ptr:2 = reloc;
    local ea:2 = *:2 ptr;
    local target:2 = ea + X;
    call [target];
}

# Mode 7: Indirect B-relative + X-indexed
:JPL ",X I "^disp^",B" is op5=0x17 & X_bit=1 & I_bit=1 & B_bit=1 & disp {
    L = inst_start + 1;
    local ptr:2 = B + disp;
    local ea:2 = *:2 ptr;
    local target:2 = ea + X;
    call [target];
}


:JXN rel_target is op8=0xB7 & rel_target {  # 0133400 octal = 0xB700, 8-bit mask (jump)
    # 0133400 octal = 0xB700, 8-bit mask (jump)
    if (X s>= 0) goto <no_jump>;              # Skip if X not negative
    goto rel_target;
<no_jump>
}


:JXZ rel_target is op8=0xB6 & rel_target {  # 0133000 octal = 0xB600, 8-bit mask (jump)
    # 0133000 octal = 0xB600, 8-bit mask (jump)
    if (X != 0) goto <no_jump>;               # Skip if X not zero
    goto rel_target;
<no_jump>
}


:LACB disp3 is op10=0x307 & disp3 & fixed3=0x2 {  # 140702 octal = 0xC1C2, 10-bit mask
    # 140702 octal = 0xC1C2, 10-bit mask
    # LACB: Bank operation with B-relative addressing
    local ea:2 = B + disp3;              # B-relative addressing with 3-bit displacement
    A = *:2 ea;                               # Load into A register from bank
    # LACB: Bank type determined by instruction - Core Map Bank (CMB) or Segment Table Bank (STB)
}


:LASB disp3 is op10=0x307 & disp3 & fixed3=0x0 {  # 140700 octal = 0xC1C0, 10-bit mask
    # 140700 octal = 0xC1C0, 10-bit mask
    # LASB: Bank operation with B-relative addressing
    local ea:2 = B + disp3;              # B-relative addressing with 3-bit displacement
    A = *:2 ea;                               # Load into A register from bank
    # LASB: Bank type determined by instruction - Core Map Bank (CMB) or Segment Table Bank (STB)
}


:LBIT is op16=0xC148 {  # 140510 octal = 0xC148, 16-bit mask
    # LBIT: Load single bit accumulator K from logical memory bit
    # YAML: X = bit array base, A = bit index within array
    nd100_lbit(A, X);
}


:LBITP is op16=0xC149 {  # 140511 octal = 0xC149, 16-bit mask
    # LBITP: Load single bit accumulator K from physical memory bit (ND-110/CX)
    # YAML: T = bank, X = bit array base, A = bit index
    nd100_lbit(A, X, T);
}


:LBYT is op16=0xC480 {  # 142200 octal = 0xC480, 16-bit mask
    # LBYT: Load byte from memory to A — address from T+X/2
    nd100_lbyt(A, T, X);
}


:LBYTP is op16=0xC14C {  # 140514 octal = 0xC14C, 16-bit mask
    # LBYTP: Load byte from physical memory to A (ND-110/CX)
    # YAML: D = bank number, T = start address, X = byte offset
    nd100_lbyt(A, D, T, X);
}


:LDA addr is op5=0x09 & addr {  # 044000 octal = 0x4800, 5-bit mask (addr)
    # 044000 octal = 0x4800, 5-bit mask (addr)
    A = addr;                                # Load into A register (addr sub-table)
}


:LDATX disp3 is op10=0x31B & disp3 & fixed3=0x0 {  # 143300 octal = 0xC6C0, 10-bit mask
    # 143300 octal = 0xC6C0, 10-bit mask
    local ea:2 = X + disp3;                  # T/X addressing (X + 3-bit displacement)
    A = *:2 ea;                              # Load into A register
}


:LDBTX disp3 is op10=0x31B & disp3 & fixed3=0x3 {  # 143303 octal = 0xC6C3, 10-bit mask
    # 143303 octal = 0xC6C3, 10-bit mask
    # LDBTX: B = (mem[X+disp] * 2) | 0xFE00
    local ea:2 = X + disp3;                  # T/X addressing (X + 3-bit displacement)
    local val:2 = *:2 ea;
    B = (val << 1) | 0xFE00;                 # Double and mask for stack pointer format
}


:LDD ea_addr is op5=0x05 & ea_addr {  # 024000 octal = 0x2800, 5-bit mask (ea_addr)
    # 024000 octal = 0x2800, 5-bit mask (ea_addr)
    # LDD: Load double word — A from (EA), D from (EA+1)
    local ea:2 = ea_addr;
    A = *:2 ea;
    local ea1:2 = ea + 1;
    D = *:2 ea1;
}


:LDDTX disp3 is op10=0x31B & disp3 & fixed3=0x2 {  # 143302 octal = 0xC6C2, 10-bit mask
    # 143302 octal = 0xC6C2, 10-bit mask
    local ea:2 = X + disp3;                  # T/X addressing (X + 3-bit displacement)
    A = *:2 ea;                              # Load A from memory location
    D = *:2 (ea + 1);                        # Load D from memory location + 1
}


:LDF ea_addr is op5=0x07 & ea_addr {  # 034000 octal = 0x3800, 5-bit mask (ea_addr)
    # 034000 octal = 0x3800, 5-bit mask (ea_addr)
    # LDF: Load floating accumulator — T from (EA), A from (EA+1), D from (EA+2)
    local ea:2 = ea_addr;
    T = *:2 ea;
    local ea1:2 = ea + 1;
    A = *:2 ea1;
    local ea2:2 = ea + 2;
    D = *:2 ea2;
}


:LDT addr is op5=0x0A & addr {  # 050000 octal = 0x5000, 5-bit mask (addr)
    # 050000 octal = 0x5000, 5-bit mask (addr)
    T = addr;                                # Load into T register (addr sub-table)
}


:LDX addr is op5=0x0B & addr {  # 054000 octal = 0x5800, 5-bit mask (addr)
    # 054000 octal = 0x5800, 5-bit mask (addr)
    X = addr;                                # Load into X register (addr sub-table)
}


:LDXTX disp3 is op10=0x31B & disp3 & fixed3=0x1 {  # 143301 octal = 0xC6C1, 10-bit mask
    # 143301 octal = 0xC6C1, 10-bit mask
    local ea:2 = X + disp3;                  # T/X addressing (X + 3-bit displacement)
    X = *:2 ea;                              # Load into X register
}


:LEAVE is op16=0xC05E {  # 0140136 octal = 0xC05E, 16-bit mask
    # LEAVE: Leave stack frame
    # C source: ndfunc_leave() — PC = [B-128](LINK), B = [B-127](PREVB)
    local link:2 = B - 128;
    local prevb:2 = B - 127;
    local ret_addr:2 = *:2 link;
    B = *:2 prevb;
    return [ret_addr];
}


:LRB rop_src_d is op10=0x356 & rop_src_d & rop_dst_d & rop_src & rop_dst {  # 152600 octal = 0xD580, 10-bit mask
    # LRB: Load register bank — load all registers for a priority level from memory at X
    nd100_lrb(rop_src, rop_dst, X);
}


:LWCS is op16=0xC740 {  # 143500 octal = 0xC740, 16-bit mask
    # LWCS: Load writable control store — NOP on ND-110
    nd100_lwcs();
}


:LXCB disp3 is op10=0x307 & disp3 & fixed3=0x5 {  # 140705 octal = 0xC1C5, 10-bit mask
    # 140705 octal = 0xC1C5, 10-bit mask
    # LXCB: Bank operation with B-relative addressing
    local ea:2 = B + disp3;              # B-relative addressing with 3-bit displacement
    X = *:2 ea;                               # Load into X register from bank
    # LXCB: Bank type determined by instruction - Core Map Bank (CMB) or Segment Table Bank (STB)
}


:LXSB disp3 is op10=0x307 & disp3 & fixed3=0x4 {  # 140704 octal = 0xC1C4, 10-bit mask
    # 140704 octal = 0xC1C4, 10-bit mask
    # LXSB: Bank operation with B-relative addressing
    local ea:2 = B + disp3;              # B-relative addressing with 3-bit displacement
    X = *:2 ea;                               # Load into X register from bank
    # LXSB: Bank type determined by instruction - Core Map Bank (CMB) or Segment Table Bank (STB)
}


:MCL reg4 is op12=0xD08 & reg4 {  # 0150200 octal = 0xD080, 12-bit mask
    # MCL: Masked clear — clear selected bits in system register using mask in A
    local regsel:1 = reg4;
    nd100_mcl(regsel, A);
}


# MIN: Memory Increment — increment word at EA, skip next if result is zero
# Full constructor to include skip_next sub-table for decompiler support

:MIN addr^" "^skip_next is op5=0x08 & addr & skip_next {
    local memval:2 = addr;
    local result:2 = memval + 1;
    addr = result;
    if (result != 0) goto <no_skip>;
    goto skip_next;
<no_skip>
}


:MIX3 is op16=0xC680 {  # 143200 octal = 0xC680, 16-bit mask
    # 143200 octal = 0xC680, 16-bit mask
    # MIX3: Multiply index by 3 - X = (A - 1) * 3
    local index:2 = A - 1;                    # Subtract 1 from A
    local result:4 = zext(index) * 3;         # Multiply by 3 (32-bit to avoid overflow)
    X = result:2;                             # Store result in X register
    # Used for indexing into 3-element structures or records
}


:MON imm8 is op8=0xD6 & imm8 {  # 153000 octal = 0xD600, 8-bit mask (unsigned)
    # 153000 octal = 0xD600, 8-bit mask
    # MON: Monitor call — software trap to interrupt level 14
    # C source: mon_code = IR & 0x1ff, store to level 14 T register, trigger interrupt(14)
    local mon_code:1 = imm8;
    nd100_mon(mon_code);
}


:MOVB is op16=0xC059 {  # 0140131 octal = 0xC059, 16-bit mask
    # MOVB: Move bytes — src A+D descriptor, dst X+T descriptor
    nd100_movb(A, X, D, T);
}


:MOVBF is op16=0xC05A {  # 0140132 octal = 0xC05A, 16-bit mask
    # MOVBF: Move bytes forward — src A+D descriptor, dst X+T descriptor
    nd100_movb(A, X, D, T);
}


:MOVEW reg3_d is op13=0x18C8 & reg3_d & reg3 {  # 0143100 octal = 0xC640, 13-bit mask
    # MOVEW: Word block move — uses A, D, X, T, L for addresses and count
    # YAML: L = word count
    nd100_movew(reg3, A, D, X, T, L);
}


:MPY addr is op5=0x14 & addr {  # 120000 octal = 0xA000, 5-bit mask (addr)
    # 120000 octal = 0xA000, 5-bit mask (addr)
    # MPY: A = A * mem[EA], flags O/Q on overflow (|result| > 32767)
    # C source: signed 16x16->16, sets O and Q on overflow
    local memval:2 = addr;                    # Load memory value via addr sub-table
    local tmp:4 = sext(A) * sext(memval);     # 32-bit signed multiply
    A = tmp:2;                                # Store low 16 bits
    local overflow:1 = (tmp s> 32767) | (tmp s< -32767);
    STS[5,5] = overflow;                      # O = overflow (dynamic)
    STS[4,4] = STS[4,4] | overflow;           # Q = sticky overflow
}


:MST reg4 is op12=0xD0C & reg4 {  # 0150300 octal = 0xD0C0, 12-bit mask
    # MST: Masked set — set selected bits in system register using mask in A
    local regsel:1 = reg4;
    nd100_mst(regsel, A);
}


:NLZ disp is op8=0xD3 & disp {  # 0151400 octal = 0xD300, 8-bit mask
    # NLZ: Normalize — convert integer A to floating point T:A:D
    # Ref: Instructions.FloatingPointConversion.cs:82
    # NOT "negate A and jump" — that was completely wrong
    local scale:2 = disp;                     # Scaling factor (sign-extended by assignment)
    nd100_normalize(T, A, D, scale);          # Convert integer A to float T:A:D
}


:OPCOM is op16=0xD100 {  # 150400 octal = 0xD100, 16-bit mask
    # OPCOM: Operator communication — halt CPU, enter operator mode
    nd100_opcom();
}


:ORA addr is op5=0x0F & addr {  # 074000 octal = 0x7800, 5-bit mask (addr)
    # 074000 octal = 0x7800, 5-bit mask (addr)
    local memval:2 = addr;                    # Load memory value via addr sub-table
    A = A | memval;                          # Bitwise OR with memory value
}


:PACK is op16=0xC054 {  # 0140124 octal = 0xC054, 16-bit mask
    # PACK: Convert ASCII to packed BCD — A+D (source), X+T (destination)
    # Skips next instruction on success
    nd100_bcd_pack(A, D, T, X);
}


:PIOF is op16=0xD105 {  # 150405 octal = 0xD105, 16-bit mask
    # PIOF: Disable paging and interrupts
    PONI = 0;
    IONI = 0;
}


:PION is op16=0xD10A {  # 150412 octal = 0xD10A, 16-bit mask
    # PION: Enable paging and interrupts
    PONI = 1;
    IONI = 1;
}


:POF is op16=0xD104 {  # 150404 octal = 0xD104, 16-bit mask
    # POF: Disable paging (memory management)
    PONI = 0;
}


:PON is op16=0xD108 {  # 150410 octal = 0xD108, 16-bit mask
    # PON: Enable paging (memory management)
    PONI = 1;
}


# RADD - Register add with modifiers
# 0146000 octal = 0xCC00, 6-bit mask
# Bits 9-8=AD mode, 7=CM1, 6=CLD, 5-3=src, 2-0=dst

:RADD rop_src_d rop_dst_d is op5=0x19 & X_bit=1 & rop_ad & rop_cm1 & rop_cld & rop_src_d & rop_dst_d & rop_src & rop_dst {
    # RADD: Register add with modifiers (CLD, CM1, AD1/ADC)
    # Modifier bits: rop_ad(9-8)=AD mode, rop_cm1(7)=complement, rop_cld(6)=clear dst
    # Raw token fields need local assignment for size resolution

    local cm1:1 = rop_cm1;
    local cld:1 = rop_cld;
    local ad:1 = rop_ad;

    # Prepare source operand (apply CM1)
    local src_op:2 = rop_src;
    if (cm1 == 0) goto <src_ready>;
    src_op = ~rop_src;
<src_ready>

    # Prepare destination operand (apply CLD)
    local dst_op:2 = rop_dst;
    if (cld == 0) goto <dst_ready>;
    dst_op = 0;
<dst_ready>

    # Determine addend from AD mode
    local addend:2 = 0;
    if (ad == 0) goto <do_add>;
    if (ad == 2) goto <use_carry>;
    # AD mode 01 = AD1: addend = 1
    addend = 1;
    goto <do_add>;
<use_carry>
    # AD mode 10 = ADC: addend = carry flag
    addend = zext(STS[6,6]);
<do_add>
    # Perform addition: result = dst_op + src_op + addend
    local tmp:4 = zext(dst_op) + zext(src_op) + zext(addend);
    local result:2 = tmp:2;
    rop_dst = result;
    STS[6,6] = (tmp >> 16) != 0;                 # C = carry out
    # O = signed overflow: signs of inputs match but result sign differs
    local sign_a:1 = (dst_op >> 15) != 0;
    local sign_b:1 = (src_op >> 15) != 0;
    local sign_r:1 = (result >> 15) != 0;
    STS[5,5] = (sign_a == sign_b) & (sign_r != sign_a);  # O (dynamic)
    STS[4,4] = STS[4,4] | STS[5,5];              # Q = sticky overflow
}


:RAND rop_src_d is op10=0x324 & rop_src_d & rop_dst_d & rop_src & rop_dst {  # 144400 octal = 0xC900, 10-bit mask
    # 144400 octal = 0xC900, 10-bit mask
    rop_dst = rop_dst & rop_src;                 # Bitwise AND registers
}


:RCLR reg3_d is op13=0x1988 & reg3_d & reg3 {  # 0146100 octal = 0xCC40, 13-bit mask
    # 0146100 octal = 0xCC40, 13-bit mask
    reg3 = 0;                              # Clear destination register
    STS[6,6] = 0;                          # C = 0 (no carry)
    STS[5,5] = 0;                          # O = 0 (no overflow)
}


:RDCR reg3_d is op13=0x1990 & reg3_d & reg3 {  # 146200 octal = 0xCC80, 13-bit mask
    # 146200 octal = 0xCC80, 13-bit mask
    STS[5,5] = sborrow(reg3, 1);           # O = signed overflow on decrement
    STS[4,4] = STS[4,4] | STS[5,5];       # Q = sticky overflow
    STS[6,6] = (reg3 != 0);               # C = no borrow
    reg3 = reg3 - 1;                       # Decrement destination register
}


:RDIV rop_src_d is op10=0x30E & rop_src_d & rop_dst_d & rop_src & rop_dst {  # 141600 octal = 0xC380, 10-bit mask
    # RDIV: 32-bit A:D / src, quotient->A, remainder->D
    # C source: signed divide, Z on overflow/div-by-zero, C if |quotient| >= 32768
    local dividend:4 = (zext(A) << 16) | zext(D); # 32-bit A:D
    if (rop_src == 0) goto <div_zero>;
    local quotient:4 = dividend s/ sext(rop_src);  # Signed divide
    local remainder:4 = dividend s% sext(rop_src); # Signed remainder
    # Check overflow: |quotient| >= 32768
    local ovf:1 = (quotient s> 32767) | (quotient s< -32768);
    if (ovf != 0) goto <overflow>;
    A = quotient:2;                                # Quotient to A
    D = remainder:2;                               # Remainder to D
    STS[6,6] = 0;                                  # C = 0 (fits in 16 bits)
    goto <done>;
<div_zero>
<overflow>
    STS[3,3] = 1;                                  # Z = 1 (error flag, bit 3)
<done>
}


:RDUS is op16=0xC057 {  # 140127 octal = 0xC057, 16-bit mask
    # RDUS: Read word without using cache — address in T, result in A
    A = nd100_rdus(T);
}


:RDUSP is op16=0xC14F {  # 140517 octal = 0xC14F, 16-bit mask
    # RDUSP: Read physical memory word without cache (ND-110/CX only)
    # Uses T (bank number) and X (address within bank)
    A = nd100_rdus(T, X);
}


:REMPL is op16=0xC143 {  # 140503 octal = 0xC143, 16-bit mask
    # REMPL: Remove page from page list — privileged
    nd100_page_op(A, D, T, X);
}


:REPT is op16=0xC147 {  # 140507 octal = 0xC147, 16-bit mask
    # REPT: Enter reentrant segment in page tables — privileged
    nd100_page_op(A, D, T, X);
}


:REX is op16=0xD107 {  # 0150407 octal = 0xD107, 16-bit mask
    # REX: Reset extended addressing mode (back to 19-bit)
    SEXI = 0;
}


:REXO rop_src_d is op10=0x328 & rop_src_d & rop_dst_d & rop_src & rop_dst {  # 0145000 octal = 0xCA00, 10-bit mask
    # 0145000 octal = 0xCA00, 10-bit mask
    rop_dst = rop_dst ^ rop_src;            # Exclusive OR source into destination
}


:RGLOB is op16=0xC141 {  # 140501 octal = 0xC141, 16-bit mask
    # RGLOB: Read global pointers — STBNK->T, STSRT->A, CMBUK->D
    nd100_rglob(T, A, D);
}


:RINC reg3_d is op13=0x19A0 & reg3_d & reg3 {  # 146400 octal = 0xCD00, 13-bit mask
    # 146400 octal = 0xCD00, 13-bit mask
    STS[5,5] = scarry(reg3, 1);            # O = signed overflow on increment
    STS[4,4] = STS[4,4] | STS[5,5];       # Q = sticky overflow
    STS[6,6] = carry(reg3, 1);             # C = unsigned carry
    reg3 = reg3 + 1;                       # Increment destination register
}


:RMPY rop_src_d is op10=0x30A & rop_src_d & rop_dst_d & rop_src & rop_dst {  # 141200 octal = 0xC280, 10-bit mask
    # RMPY: 32-bit signed multiply, result in A:D
    # C source: handles signs separately, C if |result| > 16 bits
    local src_val:2 = rop_src;
    local dst_val:2 = rop_dst;
    local result:4 = sext(src_val) * sext(dst_val); # 32-bit signed multiply
    A = result(2);                                # High 16 bits to A
    D = result:2;                                 # Low 16 bits to D
    # C = 1 if result doesn't fit in 16 bits (check absolute value)
    STS[6,6] = (result s> 32767) | (result s< -32768);
}


:RORA rop_src_d is op10=0x32C & rop_src_d & rop_dst_d & rop_src & rop_dst {  # 145400 octal = 0xCB00, 10-bit mask
    # 145400 octal = 0xCB00, 10-bit mask
    rop_dst = rop_dst | rop_src;                 # Bitwise OR registers
}


:RSUB rop_src_d is op10=0x336 & rop_src_d & rop_dst_d & rop_src & rop_dst {  # 146600 octal = 0xCD80, 10-bit mask
    # 146600 octal = 0xCD80, 10-bit mask
    # RSUB: dr = dr - sr (RADD CM1 AD1 alias)
    # C source: do_add(destination, ~source, 1) — sets C, O, Q
    local old_dst:2 = rop_dst;
    local comp:2 = ~rop_src;
    local tmp:4 = zext(old_dst) + zext(comp) + 1;
    rop_dst = tmp:2;
    STS[6,6] = (tmp >> 16) != 0;              # C = carry out (1 = no borrow)
    STS[5,5] = sborrow(old_dst, rop_src);     # O = signed overflow (dynamic)
    STS[4,4] = STS[4,4] | sborrow(old_dst, rop_src); # Q = sticky overflow
}


:SAA disp is op8=0xF1 & disp {  # 170400 octal = 0xF100, 8-bit mask
    # 170400 octal = 0xF100, 8-bit mask
    # disp is declared signed — SLEIGH auto-sign-extends to register size
    A = disp;
}


:SAB disp is op8=0xF0 & disp {  # 170000 octal = 0xF000, 8-bit mask
    # 170000 octal = 0xF000, 8-bit mask
    # SAB: Set argument to B — B = sign_extend(disp)
    # C source: setreg(_B, signExtend(operand & 0xFF))
    B = disp;
}


:SACB disp3 is op10=0x307 & disp3 & fixed3=0x3 {  # 140703 octal = 0xC1C3, 10-bit mask
    # 140703 octal = 0xC1C3, 10-bit mask
    # SACB: Bank operation with B-relative addressing
    local ea:2 = B + disp3;              # B-relative addressing with 3-bit displacement
    *:2 ea = A;                               # Store A register to bank
    # SACB: Bank type determined by instruction - Core Map Bank (CMB) or Segment Table Bank (STB)
}


:SAD shift_operand is op5=0x1B & shift_reg=0x3 & shift_operand {  # 0154600 octal = 0xD980, shift non-contiguous mask
    # SAD: Shift A:D double register (32-bit) — 4 types: Arithmetic/ROT/ZIN/LIN
    # C source: ShiftDoubleReg((A<<16)|D, operand)
    local ad:4 = (zext(A) << 16) | zext(D);
    local stype:2 = (shift_operand >> 7) & 3;
    local sdir:2 = (shift_operand >> 5) & 1;
    local cnt:2 = shift_operand & 0x1F;

    if (sdir != 0) goto <right>;
    if (stype == 1) goto <rot_left>;
    ad = ad << cnt;
    goto <split>;
<rot_left>
    ad = (ad << cnt) | (ad >> (32 - cnt));
    goto <split>;

<right>
    local rcount:2 = 32 - cnt;
    if (stype == 1) goto <rot_right>;
    if (stype == 2) goto <zin_right>;
    ad = ad s>> rcount;
    goto <split>;
<rot_right>
    ad = (ad >> rcount) | (ad << (32 - rcount));
    goto <split>;
<zin_right>
    ad = ad >> rcount;
<split>
    A = ad(2);                                # High 16 bits
    D = ad:2;                                 # Low 16 bits
}


:SASB disp3 is op10=0x307 & disp3 & fixed3=0x1 {  # 140701 octal = 0xC1C1, 10-bit mask
    # 140701 octal = 0xC1C1, 10-bit mask
    # SASB: Bank operation with B-relative addressing
    local ea:2 = B + disp3;              # B-relative addressing with 3-bit displacement
    *:2 ea = A;                               # Store A register to bank
    # SASB: Bank type determined by instruction - Core Map Bank (CMB) or Segment Table Bank (STB)
}


:SAT disp is op8=0xF2 & disp {  # 171000 octal = 0xF200, 8-bit mask
    # 171000 octal = 0xF200, 8-bit mask
    T = disp;
}


:SAX disp is op8=0xF3 & disp {  # 171400 octal = 0xF300, 8-bit mask
    # 171400 octal = 0xF300, 8-bit mask
    X = disp;
}


:SBIT is op16=0xC14A {  # 140512 octal = 0xC14A, 16-bit mask
    # SBIT: Store single bit accumulator K to logical memory bit
    # YAML: X = bit array base, A = bit index within array
    nd100_sbit(A, X);
}


:SBITP is op16=0xC14B {  # 140513 octal = 0xC14B, 16-bit mask
    # SBITP: Store single bit accumulator K to physical memory bit (ND-110/CX)
    # YAML: T = bank, X = bit array base, A = bit index
    nd100_sbit(A, X, T);
}


:SBYT is op16=0xC580 {  # 142600 octal = 0xC580, 16-bit mask
    # SBYT: Store byte from A to memory — address from T+X/2
    nd100_sbyt(A, T, X);
}


:SBYTP is op16=0xC14D {  # 140515 octal = 0xC14D, 16-bit mask
    # SBYTP: Store byte to physical memory from A (ND-110/CX)
    # YAML: D = bank number, T = start address, X = byte offset
    nd100_sbyt(A, D, T, X);
}


:SETPT is op16=0xC0C0 {  # 140300 octal = 0xC0C0, 16-bit mask
    # SETPT: Set page table entries — privileged
    # Uses A, B, D, X (B holds page table address)
    nd100_page_op(A, B, D, X);
}


:SEX is op16=0xD106 {  # 150406 octal = 0xD106, 16-bit mask
    # SEX: Set extended addressing mode (24-bit)
    SEXI = 1;
}


:SHA shift_operand is op5=0x1B & shift_reg=0x2 & shift_operand {  # 0154400 octal = 0xD900, shift non-contiguous mask
    # SHA: Shift A register — 4 types: Arithmetic/ROT/ZIN/LIN
    # C source: ShiftReg(gA, operand)
    # shift_operand encodes: bits 8-7=type, bit 5=dir, bits 4-0=count
    local stype:2 = (shift_operand >> 7) & 3;
    local sdir:2 = (shift_operand >> 5) & 1;
    local cnt:2 = shift_operand & 0x1F;

    if (sdir != 0) goto <right>;
    # --- Left shift ---
    if (stype == 1) goto <rot_left>;
    # Arith/ZIN/LIN left all fill with 0
    A = A << cnt;
    goto <done>;
<rot_left>
    local lcnt:2 = cnt & 0xF;
    A = (A << lcnt) | (A >> (16 - lcnt));
    goto <done>;

<right>
    # --- Right shift ---
    local rcount:2 = 32 - cnt;
    if (stype == 1) goto <rot_right>;
    if (stype == 2) goto <zin_right>;
    # Arithmetic right (type 0) and LIN right (type 3, approx — M flag not modeled)
    A = A s>> rcount;
    goto <done>;
<rot_right>
    local rcnt:2 = rcount & 0xF;
    A = (A >> rcnt) | (A << (16 - rcnt));
    goto <done>;
<zin_right>
    A = A >> rcount;                      # ZIN right = logical shift (zero fill)
<done>
}


:SHD shift_operand is op5=0x1B & shift_reg=0x1 & shift_operand {  # 154200 octal = 0xD880, shift non-contiguous mask
    # SHD: Shift D register — 4 types: Arithmetic/ROT/ZIN/LIN
    # C source: ShiftReg(gD, operand)
    local stype:2 = (shift_operand >> 7) & 3;
    local sdir:2 = (shift_operand >> 5) & 1;
    local cnt:2 = shift_operand & 0x1F;

    if (sdir != 0) goto <right>;
    if (stype == 1) goto <rot_left>;
    D = D << cnt;
    goto <done>;
<rot_left>
    local lcnt:2 = cnt & 0xF;
    D = (D << lcnt) | (D >> (16 - lcnt));
    goto <done>;

<right>
    local rcount:2 = 32 - cnt;
    if (stype == 1) goto <rot_right>;
    if (stype == 2) goto <zin_right>;
    D = D s>> rcount;
    goto <done>;
<rot_right>
    local rcnt:2 = rcount & 0xF;
    D = (D >> rcnt) | (D << (16 - rcnt));
    goto <done>;
<zin_right>
    D = D >> rcount;
<done>
}


:SHDE is op16=0xC056 {  # 0140126 octal = 0xC056, 16-bit mask
    # SHDE: Decimal shift — shift BCD operand based on descriptor difference
    # A+D (source), X+T (destination); skips on success
    nd100_bcd_shift(A, D, T, X);
}


:SHT shift_operand is op5=0x1B & shift_reg=0x0 & shift_operand {  # 0154000 octal = 0xD800, shift non-contiguous mask
    # SHT: Shift T register — 4 types: Arithmetic/ROT/ZIN/LIN
    # C source: ShiftReg(gT, operand)
    local stype:2 = (shift_operand >> 7) & 3;
    local sdir:2 = (shift_operand >> 5) & 1;
    local cnt:2 = shift_operand & 0x1F;

    if (sdir != 0) goto <right>;
    if (stype == 1) goto <rot_left>;
    T = T << cnt;
    goto <done>;
<rot_left>
    local lcnt:2 = cnt & 0xF;
    T = (T << lcnt) | (T >> (16 - lcnt));
    goto <done>;

<right>
    local rcount:2 = 32 - cnt;
    if (stype == 1) goto <rot_right>;
    if (stype == 2) goto <zin_right>;
    T = T s>> rcount;
    goto <done>;
<rot_right>
    local rcnt:2 = rcount & 0xF;
    T = (T >> rcnt) | (T << (16 - rcnt));
    goto <done>;
<zin_right>
    T = T >> rcount;
<done>
}


# SKP: Skip next instruction if condition true
# Full constructor to include skip_next sub-table for decompiler support
# Encoding: op5=0x18, bits 10-8=condition, bits 7-6=0, bits 5-3=src, bits 2-0=dst
# Conditions from YAML/ND-100 manual:
#   0=EQL (Z=1), 1=GEQ (S=0), 2=GRE (S^O=0), 3=MGRE (C=1),
#   4=UEQ (Z=0), 5=LSS (S=1), 6=LST (S^O=1), 7=MLST (C=0)
# C source: IsSkip() in cpu_instr.c

:SKP "IF" skp_dr_d skp_cond skp_sr_d^" "^skip_next is op5=0x18 & skp_cond & skp_fixed=0x0 & skp_sr_d & skp_dr_d & skp_sr & skp_dr & skip_next {
    local diff:2 = skp_dr - skp_sr;
    local cond:1 = skp_cond;
    local should_skip:1 = 0;
    # Compute flags for the (dr - sr) operation
    local s:1 = (diff >> 15) != 0;            # Sign flag
    local z:1 = (diff == 0);                  # Zero flag
    local o:1 = sborrow(skp_dr, skp_sr);      # Overflow flag
    local c:1 = (skp_dr >= skp_sr);            # Carry (no borrow) — unsigned >=
    if (cond != 0) goto <not0>;
    should_skip = z;                           # EQL: Z=1
    goto <check>;
<not0>
    if (cond != 1) goto <not1>;
    should_skip = (s == 0);                    # GEQ: S=0
    goto <check>;
<not1>
    if (cond != 2) goto <not2>;
    should_skip = (s == o);                    # GRE: S^O=0 (overflow-aware signed >=)
    goto <check>;
<not2>
    if (cond != 3) goto <not3>;
    should_skip = c;                           # MGRE: C=1 (unsigned >=)
    goto <check>;
<not3>
    if (cond != 4) goto <not4>;
    should_skip = (z == 0);                    # UEQ: Z=0
    goto <check>;
<not4>
    if (cond != 5) goto <not5>;
    should_skip = s;                           # LSS: S=1
    goto <check>;
<not5>
    if (cond != 6) goto <not6>;
    should_skip = (s != o);                    # LST: S^O=1 (overflow-aware signed <)
    goto <check>;
<not6>
    should_skip = (c == 0);                    # MLST: C=0 (unsigned <)
<check>
    if (should_skip == 0) goto <no_skip>;
    goto skip_next;
<no_skip>
}


:SRB rop_src_d is op10=0x354 & rop_src_d & rop_dst_d & rop_src & rop_dst {  # 152402 octal = 0xD502, 10-bit mask
    # SRB: Store register bank — save all registers for a priority level to memory at X
    nd100_srb(rop_src, rop_dst, X);
}


:STA addr is op5=0x01 & addr {  # 004000 octal = 0x0800, 5-bit mask (addr)
    # 004000 octal = 0x0800, 5-bit mask (addr)
    addr = A;                                # Store A to effective address (addr sub-table)
}


:STATX disp3 is op10=0x31B & disp3 & fixed3=0x4 {  # 143304 octal = 0xC6C4, 10-bit mask
    # 143304 octal = 0xC6C4, 10-bit mask
    local ea:2 = X + disp3;                  # T/X addressing (X + 3-bit displacement)
    *:2 ea = A;                              # Store A to memory location
}


:STD ea_addr is op5=0x04 & ea_addr {  # 020000 octal = 0x2000, 5-bit mask (ea_addr)
    # 020000 octal = 0x2000, 5-bit mask (ea_addr)
    # STD: Store double word — A to (EA), D to (EA+1)
    local ea:2 = ea_addr;
    *:2 ea = A;
    local ea1:2 = ea + 1;
    *:2 ea1 = D;
}


:STDTX disp3 is op10=0x31B & disp3 & fixed3=0x6 {  # 143306 octal = 0xC6C6, 10-bit mask
    # 143306 octal = 0xC6C6, 10-bit mask
    local ea:2 = X + disp3;                  # T/X addressing (X + 3-bit displacement)
    *:2 ea = A;                              # Store A to memory location
    *:2 (ea + 1) = D;                        # Store D to memory location + 1
}


:STF ea_addr is op5=0x06 & ea_addr {  # 030000 octal = 0x3000, 5-bit mask (ea_addr)
    # 030000 octal = 0x3000, 5-bit mask (ea_addr)
    # STF: Store floating accumulator — T to (EA), A to (EA+1), D to (EA+2)
    local ea:2 = ea_addr;
    *:2 ea = T;
    local ea1:2 = ea + 1;
    *:2 ea1 = A;
    local ea2:2 = ea + 2;
    *:2 ea2 = D;
}


:STT addr is op5=0x02 & addr {  # 010000 octal = 0x1000, 5-bit mask (addr)
    # 010000 octal = 0x1000, 5-bit mask (addr)
    addr = T;                                # Store T to effective address (addr sub-table)
}


:STX addr is op5=0x03 & addr {  # 014000 octal = 0x1800, 5-bit mask (addr)
    # 014000 octal = 0x1800, 5-bit mask (addr)
    addr = X;                                # Store X to effective address (addr sub-table)
}


:STZ addr is op5=0x00 & addr {  # 000000 octal = 0x0000, 5-bit mask (addr)
    # 000000 octal = 0x0000, 5-bit mask (addr)
    addr = 0;                                # Store zero to effective address (addr sub-table)
}


:STZTX disp3 is op10=0x31B & disp3 & fixed3=0x5 {  # 143305 octal = 0xC6C5, 10-bit mask
    # 143305 octal = 0xC6C5, 10-bit mask
    local ea:2 = X + disp3;                  # T/X addressing (X + 3-bit displacement)
    *:2 ea = 0;                              # Store zero to memory location
}


:SUB addr is op5=0x0D & addr {  # 064000 octal = 0x6800, 5-bit mask (addr)
    # SUB: A = A - mem[EA]
    # C source: do_add(gA, ~eff_word, 1) — implements as ones' complement + carry-in
    # Carry: C=1 means NO borrow (A >= mem unsigned), matching do_add convention
    local memval:2 = addr;                    # Load memory value via addr sub-table
    local old_a:2 = A;                        # Save original A for flag computation
    local comp:2 = ~memval;                   # Ones' complement
    local tmp:4 = zext(old_a) + zext(comp) + 1; # Two's complement subtract via add
    A = tmp:2;                                # Store result
    STS[6,6] = (tmp >> 16) != 0;              # C = carry out (1 = no borrow)
    STS[5,5] = sborrow(old_a, memval);        # O = signed overflow (dynamic)
    STS[4,4] = STS[4,4] | sborrow(old_a, memval); # Q = sticky overflow
}


:SUBD is op16=0xC051 {  # 0140121 octal = 0xC051, 16-bit mask
    # SUBD: BCD subtraction — uses A+D (operand 1 descriptor), X+T (operand 2 descriptor)
    # Skips next instruction on success
    nd100_bcd_sub(A, D, T, X);
}


# SWAP - Register swap with CLD/CM1 modifiers
# 144000 octal = 0xC800, 8-bit opcode (bits 15-8)
# Bits 7=CM1, 6=CLD, 5-3=src, 2-0=dst
#
# Base:          dr <- sr
# CLD:           dr <- sr; sr <- 0
# CM1:           dr <- ~sr; sr <- dr  (complement of source used)
# CM1+CLD:       dr <- ~sr; sr <- 0
#
# YAML combinations table:
#   SWAP sr dr           dr <- sr
#   SWAP CLD sr dr       dr <- sr; sr <- 0
#   SWAP CM1 sr dr       dr <- sr; sr <- dr   (i.e. exchange)
#   SWAP CM1 CLD sr dr   dr <- sr; sr <- 0

:SWAP rop_src_d rop_dst_d is op8=0xC8 & rop_cm1=0 & rop_cld=0 & rop_src_d & rop_dst_d & rop_src & rop_dst {
    # Plain SWAP: dr <- sr
    rop_dst = rop_src;
}

:SWAP" CLD" rop_src_d rop_dst_d is op8=0xC8 & rop_cm1=0 & rop_cld=1 & rop_src_d & rop_dst_d & rop_src & rop_dst {
    # SWAP CLD: dr <- sr; sr <- 0
    rop_dst = rop_src;
    rop_src = 0;
}

:SWAP" CM1" rop_src_d rop_dst_d is op8=0xC8 & rop_cm1=1 & rop_cld=0 & rop_src_d & rop_dst_d & rop_src & rop_dst {
    # SWAP CM1: exchange dr <-> sr
    local temp:2 = rop_src;
    rop_src = rop_dst;
    rop_dst = temp;
}

:SWAP" CM1 CLD" rop_src_d rop_dst_d is op8=0xC8 & rop_cm1=1 & rop_cld=1 & rop_src_d & rop_dst_d & rop_src & rop_dst {
    # SWAP CM1 CLD: dr <- sr; sr <- 0
    rop_dst = rop_src;
    rop_src = 0;
}


:SZCB disp3 is op10=0x307 & disp3 & fixed3=0x7 {  # 140707 octal = 0xC1C7, 10-bit mask
    # 140707 octal = 0xC1C7, 10-bit mask
    local ea:2 = B + disp3;                  # B-relative addressing with 3-bit displacement
    *:2 ea = 0;                              # Store zero to memory location
}


:SZSB disp3 is op10=0x307 & disp3 & fixed3=0x6 {  # 140706 octal = 0xC1C6, 10-bit mask
    # 140706 octal = 0xC1C6, 10-bit mask
    local ea:2 = B + disp3;                  # B-relative addressing with 3-bit displacement
    *:2 ea = 0;                              # Store zero to memory location
}



:TRA tra_reg is op12=0xD00 & tra_reg & reg4=0x0 {  # TRA PANS (0000 octal)
    A = read_PANS();
}

:TRA tra_reg is op12=0xD00 & tra_reg & reg4=0x1 {  # TRA STS (0001 octal)
    A = read_STS();
}

:TRA tra_reg is op12=0xD00 & tra_reg & reg4=0x2 {  # TRA OPR (0002 octal)
    A = read_OPR();
}

:TRA tra_reg is op12=0xD00 & tra_reg & reg4=0x3 {  # TRA PSR (0003 octal)
    A = read_PSR();
}

:TRA tra_reg is op12=0xD00 & tra_reg & reg4=0x4 {  # TRA PVL (0004 octal)
    A = read_PVL();
}

:TRA tra_reg is op12=0xD00 & tra_reg & reg4=0x5 {  # TRA IIC (0005 octal)
    A = read_IIC();
}

:TRA tra_reg is op12=0xD00 & tra_reg & reg4=0x6 {  # TRA PID (0006 octal)
    A = read_PID();
}

:TRA tra_reg is op12=0xD00 & tra_reg & reg4=0x7 {  # TRA PIE (0007 octal)
    A = read_PIE();
}

:TRA tra_reg is op12=0xD00 & tra_reg & reg4=0x8 {  # TRA CSR (0010 octal)
    A = read_CSR();
}

:TRA tra_reg is op12=0xD00 & tra_reg & reg4=0x9 {  # TRA ACTL (0011 octal)
    A = read_ACTL();
}

:TRA tra_reg is op12=0xD00 & tra_reg & reg4=0xA {  # TRA ALD (0012 octal)
    A = read_ALD();
}

:TRA tra_reg is op12=0xD00 & tra_reg & reg4=0xB {  # TRA PES (0013 octal)
    A = read_PES();
}

:TRA tra_reg is op12=0xD00 & tra_reg & reg4=0xC {  # TRA PGC (0014 octal)
    A = read_PGC();
}

:TRA tra_reg is op12=0xD00 & tra_reg & reg4=0xD {  # TRA PEA (0015 octal)
    A = read_PEA();
}

:TRA tra_reg is op12=0xD00 & tra_reg & reg4=0xF {  # TRA CS (0017 octal)
    A = read_CS();
}

:TRA tra_reg is op12=0xD00 & tra_reg & reg4 {  # TRA (unknown register)
    local regsel:1 = reg4;
    A = nd100_tra(regsel);
}



:TRR trr_reg is op12=0xD04 & trr_reg & reg4=0x0 {  # TRR PANC (0000 octal)
    write_PANC(A);
}

:TRR trr_reg is op12=0xD04 & trr_reg & reg4=0x1 {  # TRR STS (0001 octal)
    write_STS(A);
}

:TRR trr_reg is op12=0xD04 & trr_reg & reg4=0x2 {  # TRR LMP (0002 octal)
    write_LMP(A);
}

:TRR trr_reg is op12=0xD04 & trr_reg & reg4=0x3 {  # TRR PCR (0003 octal)
    write_PCR(A);
}

:TRR trr_reg is op12=0xD04 & trr_reg & reg4=0x5 {  # TRR IIE (0005 octal)
    write_IIE(A);
}

:TRR trr_reg is op12=0xD04 & trr_reg & reg4=0x6 {  # TRR PID (0006 octal)
    write_PID(A);
}

:TRR trr_reg is op12=0xD04 & trr_reg & reg4=0x7 {  # TRR PIE (0007 octal)
    write_PIE(A);
}

:TRR trr_reg is op12=0xD04 & trr_reg & reg4=0x8 {  # TRR CCL (0010 octal)
    write_CCL(A);
}

:TRR trr_reg is op12=0xD04 & trr_reg & reg4=0x9 {  # TRR LCIL (0011 octal)
    write_LCIL(A);
}

:TRR trr_reg is op12=0xD04 & trr_reg & reg4=0xA {  # TRR UCIL (0012 octal)
    write_UCIL(A);
}

:TRR trr_reg is op12=0xD04 & trr_reg & reg4=0xB {  # TRR CILP (0013 octal)
    write_CILP(A);
}

:TRR trr_reg is op12=0xD04 & trr_reg & reg4=0xD {  # TRR ECCR (0015 octal)
    write_ECCR(A);
}

:TRR trr_reg is op12=0xD04 & trr_reg & reg4=0xF {  # TRR CS (0017 octal)
    write_CS(A);
}

:TRR trr_reg is op12=0xD04 & trr_reg & reg4 {  # TRR (unknown register)
    local regsel:1 = reg4;
    nd100_trr(regsel, A);
}


:TSET is op16=0xC053 {  # 140123 octal = 0xC053, 16-bit mask
    # TSET: Test and set — A = mem[T], then mem[T] = 0xFFFF
    # C source: gA = MemoryRead(gT); MemoryWrite(0xFFFF, gT)
    A = nd100_tset(T);
}


:TSETP is op16=0xC14E {  # 140516 octal = 0xC14E, 16-bit mask
    # TSETP: Test and set physical memory — A = mem[T:X], then mem[T:X] = 0xFFFF
    # C source: uses T (bank) and X (address) for physical access
    A = nd100_tset(T, X);
}


:UPACK is op16=0xC055 {  # 0140125 octal = 0xC055, 16-bit mask
    # UPACK: Convert packed BCD to ASCII — A+D (source), X+T (destination)
    # Skips next instruction on success
    nd100_bcd_unpack(A, D, T, X);
}


:VERSN is op16=0xC05B {  # 140133 octal = 0xC05B, 16-bit mask
    # VERSN: Read ND-110 version info — modifies A, T, D
    # Called as void since it writes to multiple registers
    nd100_versn(A, T, D);
}


:WAIT disp is op8=0xD2 & disp {  # 151000 octal = 0xD200, 8-bit mask
    # 151000 octal = 0xD200, 8-bit mask
    # WAIT: Relinquish priority or halt if interrupts disabled
    # C source: if IONI off -> stop CPU; if level 0 -> nop;
    #           else clear PID bit for current level, trigger reschedule
    local wait_code:2 = disp & 0xFF;
    nd100_wait(wait_code);
}


:WGLOB is op16=0xC140 {  # 140500 octal = 0xC140, 16-bit mask
    # WGLOB: Write global pointers — T->STBNK, A->STSRT, D->CMBUK
    nd100_wglob(T, A, D);
}


